/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# Vite/Astro fingerprints every filename in this directory with a content
# hash, so a changed file is always a new URL — safe to cache forever
# instead of relying on revalidation. This adds to (not replaces) the
# security headers above, which still apply here via the /* rule.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
