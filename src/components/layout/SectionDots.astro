---
interface Props {
  sections: { id: string; label: string }[];
  t: any;
}

const { sections, t } = Astro.props;
---
<nav id="section-dots" aria-label={t.nav.pageSections}>
  {sections.map(s => (
    <a
      href={`#${s.id}`}
      data-label={s.label}
      aria-label={s.label}
    ></a>
  ))}
</nav>
