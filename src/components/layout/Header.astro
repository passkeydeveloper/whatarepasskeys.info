---
import { Languages, ChevronDown, Check, Sun, Moon, Menu, X } from 'lucide-astro';
import { locales, localeNames, localeHref } from '../../i18n/utils';

interface Props {
  locale: string;
  t: any;
}

const { locale, t } = Astro.props;
---
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm border-b border-indigo-50 dark:border-gray-800 shadow-sm">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-2 relative">
    <a href="#hero" class="flex items-center gap-2 sm:gap-2.5 no-underline min-w-0">
      <img src="/images/passkey-yellow-box.svg" alt="" aria-hidden="true" class="w-7 h-7 shrink-0" width="28" height="28" />
      <span class="font-bold text-gray-900 dark:text-gray-50 text-lg sm:text-xl tracking-tight">{t.site.logoText}</span>
    </a>

    <button
      type="button"
      class="header-menu-toggle inline-flex items-center justify-center sm:hidden"
      id="header-menu-toggle"
      aria-expanded="false"
      aria-controls="header-controls"
      aria-label={t.nav.openMenu}
      data-label-to-open={t.nav.openMenu}
      data-label-to-close={t.nav.closeMenu}
    >
      <Menu size={20} aria-hidden="true" class="header-menu-icon-open" />
      <X size={20} aria-hidden="true" class="header-menu-icon-close" />
    </button>

    <div class="header-controls items-center gap-3" id="header-controls">
      <div class="mode-toggle" id="mode-toggle" role="group" aria-label={t.nav.contentMode}>
        <button
          class="mode-toggle-option selected"
          id="toggle-consumer"
          aria-pressed="true"
          type="button"
        >
          {t.site.toggleConsumer}
        </button>
        <button
          class="mode-toggle-option"
          id="toggle-technical"
          aria-pressed="false"
          type="button"
        >
          {t.site.toggleTechnical}
        </button>
      </div>

      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label={t.nav.switchToDarkMode}
        data-label-to-light={t.nav.switchToLightMode}
        data-label-to-dark={t.nav.switchToDarkMode}
      >
        <Sun size={16} aria-hidden="true" class="theme-toggle-icon-light" />
        <Moon size={16} aria-hidden="true" class="theme-toggle-icon-dark" />
      </button>

      {locales.length > 1 && (
        <div class="lang-menu" id="lang-menu">
          <button
            type="button"
            class="lang-menu-button"
            id="lang-menu-button"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="lang-menu-list"
            aria-label={t.nav.language}
          >
            <Languages size={16} aria-hidden="true" />
            <span class="lang-menu-current">{locale.toUpperCase()}</span>
            <ChevronDown size={14} aria-hidden="true" class="lang-menu-chevron" />
          </button>
          <ul class="lang-menu-list" id="lang-menu-list" role="menu" aria-label={t.nav.language} hidden>
            {locales.map((code) => (
              <li role="none">
                <a
                  href={localeHref(code)}
                  role="menuitem"
                  class:list={['lang-menu-item', { selected: code === locale }]}
                  aria-current={code === locale ? 'true' : undefined}
                  data-locale={code}
                >
                  <span>{localeNames[code] ?? code}</span>
                  {code === locale && <Check size={16} aria-hidden="true" />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  const html = document.documentElement;
  const consumerBtn = document.getElementById('toggle-consumer')!;
  const technicalBtn = document.getElementById('toggle-technical')!;

  function setMode(mode: 'consumer' | 'technical') {
    html.setAttribute('data-mode', mode);
    localStorage.setItem('passkeys-mode', mode);
    consumerBtn.classList.toggle('selected', mode === 'consumer');
    technicalBtn.classList.toggle('selected', mode === 'technical');
    consumerBtn.setAttribute('aria-pressed', String(mode === 'consumer'));
    technicalBtn.setAttribute('aria-pressed', String(mode === 'technical'));
  }

  // data-mode was already set before first paint by the blocking script in
  // <head> (see Layout.astro); just sync this button's UI to match.
  if (html.getAttribute('data-mode') === 'technical') {
    consumerBtn.classList.remove('selected');
    technicalBtn.classList.add('selected');
    consumerBtn.setAttribute('aria-pressed', 'false');
    technicalBtn.setAttribute('aria-pressed', 'true');
  }

  consumerBtn.addEventListener('click', () => setMode('consumer'));
  technicalBtn.addEventListener('click', () => setMode('technical'));

  // Mobile controls menu. Below the sm breakpoint, the mode/theme/language
  // controls collapse behind a hamburger toggle instead of squeezing into
  // the header alongside the site title.
  const menuToggle = document.getElementById('header-menu-toggle')!;
  const headerControls = document.getElementById('header-controls')!;
  const menuLabelOpen = menuToggle.dataset.labelToOpen!;
  const menuLabelClose = menuToggle.dataset.labelToClose!;

  function closeHeaderMenu() {
    headerControls.classList.remove('open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', menuLabelOpen);
  }

  function openHeaderMenu() {
    headerControls.classList.add('open');
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', menuLabelClose);
  }

  menuToggle.addEventListener('click', (e) => {
    e.stopPropagation();
    if (headerControls.classList.contains('open')) closeHeaderMenu();
    else openHeaderMenu();
  });

  document.addEventListener('click', (e) => {
    if (!headerControls.contains(e.target as Node) && !menuToggle.contains(e.target as Node)) {
      closeHeaderMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && headerControls.classList.contains('open')) {
      closeHeaderMenu();
      menuToggle.focus();
    }
  });

  // Collapse the mobile menu once a control inside it has been used, since
  // it covers the page content while open.
  headerControls.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.mode-toggle-option, .theme-toggle, .lang-menu-item')) {
      closeHeaderMenu();
    }
  });

  // Theme toggle. The initial data-theme was already set by a blocking
  // script in <head> (before first paint), so this only needs to keep the
  // button's aria-label in sync and handle manual overrides from here on.
  const themeToggle = document.getElementById('theme-toggle')!;
  const labelToLight = themeToggle.dataset.labelToLight!;
  const labelToDark = themeToggle.dataset.labelToDark!;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function syncThemeLabel() {
    const isDark = html.getAttribute('data-theme') === 'dark';
    themeToggle.setAttribute('aria-label', isDark ? labelToLight : labelToDark);
  }

  function setTheme(theme: 'light' | 'dark') {
    html.setAttribute('data-theme', theme);
    syncThemeLabel();
  }

  syncThemeLabel();

  themeToggle.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem('passkeys-theme', next);
    setTheme(next);
  });

  // Live-follow the OS theme until the user explicitly pins one.
  media.addEventListener('change', (e) => {
    if (localStorage.getItem('passkeys-theme')) return;
    setTheme(e.matches ? 'dark' : 'light');
  });

  // Language dropdown
  const langMenu = document.getElementById('lang-menu');
  const langButton = document.getElementById('lang-menu-button');
  const langList = document.getElementById('lang-menu-list');

  if (langMenu && langButton && langList) {
    // Preserve the current section anchor when switching languages
    langList.querySelectorAll<HTMLAnchorElement>('.lang-menu-item').forEach((link) => {
      if (location.hash) link.href = link.pathname + location.hash;
    });

    function closeLangMenu() {
      langList!.hidden = true;
      langButton!.setAttribute('aria-expanded', 'false');
    }

    function openLangMenu() {
      langList!.hidden = false;
      langButton!.setAttribute('aria-expanded', 'true');
    }

    langButton.addEventListener('click', (e) => {
      e.stopPropagation();
      if (langList!.hidden) openLangMenu();
      else closeLangMenu();
    });

    document.addEventListener('click', (e) => {
      if (!langMenu!.contains(e.target as Node)) closeLangMenu();
    });

    langMenu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLangMenu();
        langButton!.focus();
      }
    });
  }
</script>
