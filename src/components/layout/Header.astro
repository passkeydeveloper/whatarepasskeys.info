---
interface Props {
  locale: string;
  t: any;
}

const { t } = Astro.props;
---
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm border-b border-indigo-50 shadow-sm">
  <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="#hero" class="flex items-center gap-2.5 no-underline">
      <img src="/images/passkey-yellow-box.svg" alt="" aria-hidden="true" class="w-7 h-7" />
      <span class="font-bold text-gray-900 text-xl tracking-tight">What are passkeys?</span>
    </a>

    <div class="mode-toggle" id="mode-toggle" role="group" aria-label="Content mode">
      <button
        class="mode-toggle-option selected"
        id="toggle-consumer"
        aria-pressed="true"
        type="button"
      >
        {t.site.toggleConsumer}
      </button>
      <button
        class="mode-toggle-option"
        id="toggle-technical"
        aria-pressed="false"
        type="button"
      >
        {t.site.toggleTechnical}
      </button>
    </div>
  </div>
</header>

<script>
  const html = document.documentElement;
  const consumerBtn = document.getElementById('toggle-consumer')!;
  const technicalBtn = document.getElementById('toggle-technical')!;

  function setMode(mode: 'consumer' | 'technical') {
    html.setAttribute('data-mode', mode);
    localStorage.setItem('passkeys-mode', mode);
    consumerBtn.classList.toggle('selected', mode === 'consumer');
    technicalBtn.classList.toggle('selected', mode === 'technical');
    consumerBtn.setAttribute('aria-pressed', String(mode === 'consumer'));
    technicalBtn.setAttribute('aria-pressed', String(mode === 'technical'));
  }

  // Restore saved mode
  const saved = localStorage.getItem('passkeys-mode') as 'consumer' | 'technical' | null;
  if (saved === 'technical') setMode('technical');

  consumerBtn.addEventListener('click', () => setMode('consumer'));
  technicalBtn.addEventListener('click', () => setMode('technical'));
</script>
