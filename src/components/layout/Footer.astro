---
import { lastGitCommitDate } from '../../utils/gitDate';
import { bcp47Language } from '../../i18n/utils';

interface Props {
  locale: string;
  t: any;
}

const { locale, t } = Astro.props;

// Any change to this locale's content file counts as a page update — this
// is the whole page's freshness signal, distinct from the credential
// manager scores' own last-updated date (see CredentialManagers.astro),
// which changes independently and far less often.
const contentUpdated = lastGitCommitDate(`src/i18n/${locale}.json`);
const contentUpdatedFormatted = contentUpdated
  ? new Intl.DateTimeFormat(bcp47Language(locale), { year: 'numeric', month: 'short', day: 'numeric' }).format(
      new Date(contentUpdated)
    )
  : null;
---
<footer class="bg-gray-900 text-gray-400 py-12 px-6">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
    <p>
      {t.footer.madeWith} ❤️ {t.footer.by}
    </p>
    <p>
      {contentUpdatedFormatted && (
        <>{t.footer.contentUpdated.replace('{date}', contentUpdatedFormatted)}<br /></>
      )}
      {t.footer.feedback}
      <a
        href="/feedback"
        target="_blank"
        rel="noopener noreferrer"
        class="text-indigo-400 underline decoration-dotted underline-offset-2 hover:text-indigo-300 ml-1"
      >
        {t.footer.feedbackLink}
      </a>
    </p>
    <p>
      {t.footer.licensePrefix}
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-indigo-400 underline decoration-dotted underline-offset-2 hover:text-indigo-300 ml-1"
      >
        {t.footer.licenseName}
      </a>
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/passkeydeveloper/whatarepasskeys.info"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.viewSourceOnGitHub}
        class="text-gray-400 hover:text-indigo-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.99 10.99 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
          ></path>
        </svg>
      </a>
      <a
        href="https://bsky.app/profile/whatarepasskeys.info"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.viewOnBluesky}
        class="text-gray-400 hover:text-indigo-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.912 0 3.08 0 3.768c0 .688.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.036.415-.056-.14.023-.279.039-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.02.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.688-.139-1.857-.902-2.203-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
