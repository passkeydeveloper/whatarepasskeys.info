---
import Layout from '../layouts/Layout.astro';
import Hero from './sections/Hero.astro';
import WhatIsAPasskey from './sections/WhatIsAPasskey.astro';
import HowItWorks from './sections/HowItWorks.astro';
import ProblemWithPasswords from './sections/ProblemWithPasswords.astro';
import Phishing from './sections/Phishing.astro';
import Comparison from './sections/Comparison.astro';
import CredentialManagers from './sections/CredentialManagers.astro';
import ClosingCTA from './sections/ClosingCTA.astro';
import WorkPasskeys from './sections/WorkPasskeys.astro';
import FAQ from './sections/FAQ.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Layout locale={locale}>
  <Hero t={t} />
  <WhatIsAPasskey t={t} />
  <HowItWorks t={t} />
  <ProblemWithPasswords t={t} />
  <Phishing t={t} />
  <Comparison t={t} />
  <CredentialManagers t={t} />
  <ClosingCTA t={t} />
  <WorkPasskeys t={t} />
  <FAQ t={t} />
</Layout>
