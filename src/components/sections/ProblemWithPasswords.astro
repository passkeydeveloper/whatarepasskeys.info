---
import { Repeat2, Database, Fish, Clock, Code2 } from 'lucide-astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const p = t.whyPasswordsFail;

const cards = [
  { key: 'reuse',    Icon: Repeat2,  color: 'amber', iconColor: 'text-amber-600' },
  { key: 'stolen',   Icon: Database, color: 'red',   iconColor: 'text-red-600'   },
  { key: 'phishing', Icon: Fish,     color: 'orange',iconColor: 'text-orange-600'},
  { key: 'slow',     Icon: Clock,    color: 'rose',  iconColor: 'text-rose-600'  },
] as const;

const colorMap: Record<string, string> = {
  amber: 'bg-amber-50 border-amber-200',
  red:   'bg-red-50 border-red-200',
  orange:'bg-orange-50 border-orange-200',
  rose:  'bg-rose-50 border-rose-200',
};
---
<section id="why-passwords-fail" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{p.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {p.headline}
      </h2>
      <p class="text-xl md:text-2xl text-gray-600 leading-relaxed max-w-3xl mb-12">
        {p.intro}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mb-6">
      {cards.map((card, i) => (
        <div
          class={`fade-in-section rounded-2xl p-6 border ${colorMap[card.color]} shadow-sm`}
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class={`mb-3 ${card.iconColor}`}>
            <card.Icon size={28} />
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            {card.key === 'phishing' ? (
              <a href="#phishing" class="hover:text-indigo-600 hover:underline">
                {(p.cards as any)[card.key].title}
              </a>
            ) : (
              (p.cards as any)[card.key].title
            )}
          </h3>
          <p class="text-gray-600 leading-relaxed">
            {(p.cards as any)[card.key].body}
          </p>
        </div>
      ))}
    </div>

    <p class="fade-in-section text-lg font-semibold text-gray-900 mb-12">{p.outro}</p>

    <div class="technical-only fade-in-section rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
        <Code2 size={16} />
        Technical detail
      </p>
      <h3 class="text-xl font-bold text-indigo-900 mb-3">{p.techCallout.headline}</h3>
      <p class="text-indigo-800 leading-relaxed">{p.techCallout.body}</p>
    </div>
  </div>
</section>
