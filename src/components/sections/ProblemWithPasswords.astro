---
import { Repeat2, Database, Fish, Clock, Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const p = t.whyPasswordsFail;

const cards = [
  { key: 'reuse',    Icon: Repeat2,  color: 'amber', iconColor: 'text-amber-600 dark:text-amber-400' },
  { key: 'stolen',   Icon: Database, color: 'red',   iconColor: 'text-red-600 dark:text-red-400'   },
  { key: 'phishing', Icon: Fish,     color: 'orange',iconColor: 'text-orange-600 dark:text-orange-400'},
  { key: 'slow',     Icon: Clock,    color: 'rose',  iconColor: 'text-rose-600 dark:text-rose-400'  },
] as const;

const colorMap: Record<string, string> = {
  amber: 'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800',
  red:   'bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-800',
  orange:'bg-orange-50 dark:bg-orange-950/30 border-orange-200 dark:border-orange-800',
  rose:  'bg-rose-50 dark:bg-rose-950/30 border-rose-200 dark:border-rose-800',
};
---
<section id="why-passwords-fail" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white dark:bg-gray-900">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{p.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-6">
        {p.headline}
      </h2>
      <RichText class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed mb-12" text={p.intro} />
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mb-6">
      {cards.map((card, i) => (
        <div
          class={`fade-in-section rounded-2xl p-6 border ${colorMap[card.color]} shadow-sm`}
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class={`mb-3 ${card.iconColor}`}>
            <card.Icon size={28} />
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-gray-50 mb-2">
            {card.key === 'phishing' ? (
              <a href="#phishing" class="hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline">
                {(p.cards as any)[card.key].title}
              </a>
            ) : (
              (p.cards as any)[card.key].title
            )}
          </h3>
          <RichText class="text-gray-600 dark:text-gray-400 leading-relaxed" text={(p.cards as any)[card.key].body} />
        </div>
      ))}
    </div>

    <RichText class="fade-in-section text-lg font-semibold text-gray-900 dark:text-gray-50 mb-12" text={p.outro} />

    <div class="technical-only fade-in-section rounded-2xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 dark:text-indigo-300 mb-3">
        <Code2 size={16} />
        {t.common.technicalDetail}
      </p>
      <h3 class="text-xl font-bold text-indigo-900 dark:text-indigo-200 mb-3">{p.techCallout.headline}</h3>
      <RichText class="text-indigo-800 dark:text-indigo-300 leading-relaxed" text={p.techCallout.body} />
      <TechCalloutLinks links={p.techCallout.additionalLinks} t={t} />
    </div>
  </div>
</section>
