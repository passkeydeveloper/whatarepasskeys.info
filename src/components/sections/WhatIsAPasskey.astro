---
import { Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const w = t.whatIsAPasskey;

// The device/website label boxes at the bottom of the key-pair illustration
// size themselves to whatever text a locale needs, since translated labels
// can run longer than the English originals and would otherwise overflow
// the fixed-height box.
const TITLE_MAX_CHARS = 16;
const SUBTITLE_MAX_CHARS = 22;
const TITLE_LINE_HEIGHT = 14;
const SUBTITLE_LINE_HEIGHT = 13;
const TITLE_TO_SUBTITLE_GAP = 16;
const BOX_TOP = 268;
const BOX_MIN_HEIGHT = 50;
const BOX_BOTTOM_PADDING = 11;
const BOX_FIRST_LINE_OFFSET = 23;

function wrapLabel(text: string, maxChars: number): string[] {
  const words = text.split(' ');
  const lines: string[] = [];
  let current = '';
  for (const word of words) {
    const candidate = current ? `${current} ${word}` : word;
    if (Array.from(candidate).length > maxChars && current) {
      lines.push(current);
      current = word;
    } else {
      current = candidate;
    }
  }
  if (current) lines.push(current);
  return lines;
}

function layoutLabelBox(titleText: string, subtitleText: string) {
  const titleLines = wrapLabel(titleText, TITLE_MAX_CHARS);
  const subtitleLines = wrapLabel(subtitleText, SUBTITLE_MAX_CHARS);
  const titleFirstY = BOX_TOP + BOX_FIRST_LINE_OFFSET;
  const titleLastY = titleFirstY + (titleLines.length - 1) * TITLE_LINE_HEIGHT;
  const subtitleFirstY = titleLastY + TITLE_TO_SUBTITLE_GAP;
  const subtitleLastY = subtitleFirstY + (subtitleLines.length - 1) * SUBTITLE_LINE_HEIGHT;
  const height = Math.max(BOX_MIN_HEIGHT, subtitleLastY - BOX_TOP + BOX_BOTTOM_PADDING);
  return { titleLines, subtitleLines, titleFirstY, subtitleFirstY, height };
}

const deviceBox = layoutLabelBox(`📱 ${w.diagram.device.title}`, w.diagram.device.subtitle);
const websiteBox = layoutLabelBox(`🌐 ${w.diagram.website.title}`, w.diagram.website.subtitle);
const labelBoxHeight = Math.max(deviceBox.height, websiteBox.height);
const svgHeight = Math.max(340, BOX_TOP + labelBoxHeight + 22);
---
<section id="what-is" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-linear-to-br from-indigo-50 to-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{w.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {w.headline}
      </h2>
      <RichText class="text-xl text-gray-600 leading-relaxed mb-10" text={w.body} />
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        {(['staysWithYou', 'websiteGetsKey', 'workTogether'] as const).map((key, i) => (
          <div class={`fade-in-section flex gap-4`} style={`transition-delay: ${i * 0.15}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg">
              {i + 1}
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{w.highlights[key].title}</h3>
              <RichText class="text-gray-600 leading-relaxed" text={w.highlights[key].body} />
            </div>
          </div>
        ))}
      </div>

      <!-- Key pair illustration -->
      <div class="fade-in-section flex justify-center" style="transition-delay: 0.3s">
        <svg viewBox={`0 0 320 ${svgHeight}`} class="w-full max-w-xs" aria-label={w.illustrationAlt} role="img">
          <!-- Title -->
          <text x="160" y="26" text-anchor="middle" font-family="system-ui, sans-serif" font-size="13" font-weight="600" fill="#6b7280">{w.diagram.title}</text>

          <!-- Private key (device) -->
          <rect x="20" y="48" width="130" height="190" rx="20" fill="#4f46e5" opacity="0.1" stroke="#4f46e5" stroke-width="1.5"/>
          <text x="85" y="76" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#4f46e5">{w.diagram.privateKeyLabel}</text>
          <!-- Key SVG -->
          <g transform="translate(69, 126)">
            <circle cx="0" cy="0" r="20" fill="#4f46e5" opacity="0.2" stroke="#4f46e5" stroke-width="2"/>
            <circle cx="0" cy="0" r="12" fill="none" stroke="#4f46e5" stroke-width="2.5"/>
            <rect x="16" y="-5" width="32" height="10" rx="5" fill="#4f46e5" opacity="0.8"/>
            <rect x="38" y="5" width="8" height="8" rx="2" fill="#4f46e5"/>
            <rect x="46" y="5" width="6" height="6" rx="2" fill="#4f46e5" opacity="0.6"/>
          </g>
          <text x="85" y="176" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#4f46e5">{w.diagram.private.line1}</text>
          <text x="85" y="190" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#4f46e5">{w.diagram.private.line2}</text>
          <text x="85" y="204" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#4f46e5">{w.diagram.private.line3}</text>

          <!-- Link -->
          <line x1="150" y1="126" x2="170" y2="126" stroke="#059669" stroke-width="2.5" stroke-dasharray="5,3" stroke-linecap="round"/>
          <text x="160" y="116" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857" font-weight="700">{w.diagram.linked}</text>

          <!-- Public key (website) -->
          <rect x="170" y="48" width="130" height="190" rx="20" fill="#10b981" opacity="0.1" stroke="#10b981" stroke-width="1.5"/>
          <text x="235" y="76" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#047857">{w.diagram.publicKeyLabel}</text>
          <!-- Lock SVG -->
          <g transform="translate(235, 124)">
            <rect x="-18" y="-5" width="36" height="28" rx="6" fill="#10b981" opacity="0.3" stroke="#10b981" stroke-width="2"/>
            <path d="M-10 -5 Q-10 -20 0 -20 Q10 -20 10 -5" stroke="#10b981" stroke-width="3" fill="none" stroke-linecap="round"/>
            <circle cx="0" cy="8" r="5" fill="#059669" opacity="0.8"/>
          </g>
          <text x="235" y="176" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857">{w.diagram.public.line1}</text>
          <text x="235" y="190" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857">{w.diagram.public.line2}</text>
          <text x="235" y="204" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857">{w.diagram.public.line3}</text>

          <!-- Device box -->
          <rect x="20" y="268" width="130" height={labelBoxHeight} rx="12" fill="#f8f7ff" stroke="#e0e7ff" stroke-width="1.5"/>
          <text x="85" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#4f46e5">
            {deviceBox.titleLines.map((line, i) => (
              <tspan x="85" y={deviceBox.titleFirstY + i * TITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>
          <text x="85" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#6b7280">
            {deviceBox.subtitleLines.map((line, i) => (
              <tspan x="85" y={deviceBox.subtitleFirstY + i * SUBTITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>

          <!-- Website box -->
          <rect x="170" y="268" width="130" height={labelBoxHeight} rx="12" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1.5"/>
          <text x="235" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#047857">
            {websiteBox.titleLines.map((line, i) => (
              <tspan x="235" y={websiteBox.titleFirstY + i * TITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>
          <text x="235" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#6b7280">
            {websiteBox.subtitleLines.map((line, i) => (
              <tspan x="235" y={websiteBox.subtitleFirstY + i * SUBTITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>

          <!-- Arrows -->
          <line x1="85" y1="238" x2="85" y2="268" stroke="#c7d2fe" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
          <line x1="235" y1="238" x2="235" y2="268" stroke="#bbf7d0" stroke-width="1.5" marker-end="url(#arrowGreen)"/>

          <defs>
            <marker id="arrowBlue" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
              <path d="M0,0 L0,8 L8,4 z" fill="#c7d2fe"/>
            </marker>
            <marker id="arrowGreen" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
              <path d="M0,0 L0,8 L8,4 z" fill="#bbf7d0"/>
            </marker>
          </defs>
        </svg>
      </div>
    </div>

    <!-- Technical callout -->
    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
        <Code2 size={16} />
        {t.common.technicalDetail}
      </p>
      <h3 class="text-xl font-bold text-indigo-900 mb-3">{w.techCallout.headline}</h3>
      <RichText class="text-indigo-800 leading-relaxed" text={w.techCallout.body} />
      <TechCalloutLinks links={w.techCallout.additionalLinks} t={t} />
    </div>
  </div>
</section>
