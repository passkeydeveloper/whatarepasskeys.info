---
import { Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const w = t.whatIsAPasskey;
---
<section id="what-is" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-linear-to-br from-indigo-50 to-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{w.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {w.headline}
      </h2>
      <RichText class="text-xl text-gray-600 leading-relaxed mb-10" text={w.body} />
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        {(['staysWithYou', 'websiteGetsKey', 'workTogether'] as const).map((key, i) => (
          <div class={`fade-in-section flex gap-4`} style={`transition-delay: ${i * 0.15}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg">
              {i + 1}
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{w.highlights[key].title}</h3>
              <RichText class="text-gray-600 leading-relaxed" text={w.highlights[key].body} />
            </div>
          </div>
        ))}
      </div>

      <!-- Key pair illustration -->
      <div class="fade-in-section flex justify-center" style="transition-delay: 0.3s">
        <svg viewBox="0 0 320 340" class="w-full max-w-xs" aria-label="Public and private key pair illustration" role="img">
          <!-- Title -->
          <text x="160" y="26" text-anchor="middle" font-family="system-ui, sans-serif" font-size="13" font-weight="600" fill="#6b7280">Two keys. One pair.</text>

          <!-- Private key (device) -->
          <rect x="20" y="48" width="130" height="190" rx="20" fill="#4f46e5" opacity="0.1" stroke="#4f46e5" stroke-width="1.5"/>
          <text x="85" y="76" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#4f46e5">PRIVATE KEY</text>
          <!-- Key SVG (private, hidden) -->
          <g transform="translate(66, 126)">
            <circle cx="0" cy="0" r="22" fill="#4f46e5" opacity="0.08"/>
            <circle cx="0" cy="0" r="15" fill="#4f46e5"/>
            <circle cx="0" cy="0" r="6" fill="#f8f7ff"/>
            <rect x="12" y="-5" width="34" height="10" rx="2.5" fill="#4f46e5"/>
            <rect x="39" y="3" width="7" height="11" rx="2" fill="#4f46e5"/>
            <g transform="translate(-11, 13)">
              <circle r="9.5" fill="#f8f7ff" stroke="#4f46e5" stroke-width="1.5"/>
              <ellipse cx="0" cy="0" rx="5.2" ry="3" fill="none" stroke="#4f46e5" stroke-width="1.4"/>
              <circle cx="0" cy="0" r="1.4" fill="#4f46e5"/>
              <line x1="-5.5" y1="4.5" x2="5.5" y2="-4.5" stroke="#4f46e5" stroke-width="1.6" stroke-linecap="round"/>
            </g>
          </g>
          <text x="85" y="176" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#4f46e5">Stays on your</text>
          <text x="85" y="190" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#4f46e5">devices.</text>
          <text x="85" y="204" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#4f46e5">Never shared</text>

          <!-- Link -->
          <line x1="150" y1="126" x2="170" y2="126" stroke="#059669" stroke-width="2.5" stroke-dasharray="5,3" stroke-linecap="round"/>
          <text x="160" y="116" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857" font-weight="700">linked</text>

          <!-- Public key (website) -->
          <rect x="170" y="48" width="130" height="190" rx="20" fill="#10b981" opacity="0.1" stroke="#10b981" stroke-width="1.5"/>
          <text x="235" y="76" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#047857">PUBLIC KEY</text>
          <!-- Key SVG (public, visible) -->
          <g transform="translate(216, 126)">
            <circle cx="0" cy="0" r="22" fill="#10b981" opacity="0.08"/>
            <circle cx="0" cy="0" r="15" fill="#10b981"/>
            <circle cx="0" cy="0" r="6" fill="#f0fdf4"/>
            <rect x="12" y="-5" width="34" height="10" rx="2.5" fill="#10b981"/>
            <rect x="39" y="3" width="7" height="11" rx="2" fill="#10b981"/>
            <g transform="translate(-11, 13)">
              <circle r="9.5" fill="#f0fdf4" stroke="#10b981" stroke-width="1.5"/>
              <ellipse cx="0" cy="0" rx="5.2" ry="3" fill="none" stroke="#059669" stroke-width="1.4"/>
              <circle cx="0" cy="0" r="1.4" fill="#059669"/>
            </g>
          </g>
          <text x="235" y="176" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857">Shared with the </text>
          <text x="235" y="190" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857">website. Useless</text>
          <text x="235" y="204" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#047857">without private key</text>

          <!-- Device box -->
          <rect x="20" y="268" width="130" height="50" rx="12" fill="#f8f7ff" stroke="#e0e7ff" stroke-width="1.5"/>
          <text x="85" y="291" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#4f46e5">📱 Your Device</text>
          <text x="85" y="307" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#6b7280">Credential Manager</text>

          <!-- Website box -->
          <rect x="170" y="268" width="130" height="50" rx="12" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1.5"/>
          <text x="235" y="291" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#047857">🌐 Website Server</text>
          <text x="235" y="307" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#6b7280">Stores public key only</text>

          <!-- Arrows -->
          <line x1="85" y1="238" x2="85" y2="268" stroke="#c7d2fe" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
          <line x1="235" y1="238" x2="235" y2="268" stroke="#bbf7d0" stroke-width="1.5" marker-end="url(#arrowGreen)"/>

          <defs>
            <marker id="arrowBlue" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
              <path d="M0,0 L0,8 L8,4 z" fill="#c7d2fe"/>
            </marker>
            <marker id="arrowGreen" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
              <path d="M0,0 L0,8 L8,4 z" fill="#bbf7d0"/>
            </marker>
          </defs>
        </svg>
      </div>
    </div>

    <!-- Technical callout -->
    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
        <Code2 size={16} />
        Technical detail
      </p>
      <h3 class="text-xl font-bold text-indigo-900 mb-3">{w.techCallout.headline}</h3>
      <RichText class="text-indigo-800 leading-relaxed" text={w.techCallout.body} />
      <TechCalloutLinks links={w.techCallout.additionalLinks} />
    </div>
  </div>
</section>
