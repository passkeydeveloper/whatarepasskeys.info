---
import { Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const w = t.whatIsAPasskey;

// Every text block in the key-pair illustration (the PRIVATE/PUBLIC KEY
// boxes and the device/website label boxes below them) sizes itself to
// whatever text a locale needs, since translated labels can run longer
// than the English originals and would otherwise overflow a fixed-size box.
// The "MAX_CHARS" constants below are really max *width units*: a Latin
// character counts as 1, but CJK/fullwidth characters (Japanese, Chinese,
// Korean) render roughly twice as wide at the same font size and count as 2,
// so a line of Japanese text doesn't silently overflow a box tuned for Latin.
const TITLE_MAX_CHARS = 16;
const SUBTITLE_MAX_CHARS = 22;
const TITLE_LINE_HEIGHT = 14;
const SUBTITLE_LINE_HEIGHT = 13;
const TITLE_TO_SUBTITLE_GAP = 16;
const BOX_MIN_HEIGHT = 50;
const BOX_BOTTOM_PADDING = 11;
const BOX_FIRST_LINE_OFFSET = 23;

function charWidth(ch: string): number {
  const code = ch.codePointAt(0) ?? 0;
  const isWide =
    (code >= 0x1100 && code <= 0x115f) || // Hangul Jamo
    (code >= 0x2e80 && code <= 0xa4cf) || // CJK Radicals ... Yi Radicals
    (code >= 0xac00 && code <= 0xd7a3) || // Hangul Syllables
    (code >= 0xf900 && code <= 0xfaff) || // CJK Compatibility Ideographs
    (code >= 0xff00 && code <= 0xff60) || // Fullwidth Forms
    (code >= 0xffe0 && code <= 0xffe6) || // Fullwidth Signs
    (code >= 0x20000 && code <= 0x3ffff); // CJK Extension B and beyond
  return isWide ? 2 : 1;
}

function textWidth(text: string): number {
  return Array.from(text).reduce((sum, ch) => sum + charWidth(ch), 0);
}

function wrapLabel(text: string, maxWidth: number): string[] {
  const words = text.split(' ');
  const lines: string[] = [];
  let current = '';

  for (const word of words) {
    // Space-less scripts (Japanese, Chinese) turn an entire sentence into
    // one "word" here, and a single very long Latin token is possible too,
    // so a word wider than a full line wraps at the character level instead
    // of overflowing.
    if (textWidth(word) > maxWidth) {
      if (current) {
        lines.push(current);
        current = '';
      }
      let chunk = '';
      let chunkWidth = 0;
      for (const ch of Array.from(word)) {
        const w = charWidth(ch);
        if (chunkWidth + w > maxWidth && chunk) {
          lines.push(chunk);
          chunk = '';
          chunkWidth = 0;
        }
        chunk += ch;
        chunkWidth += w;
      }
      current = chunk;
      continue;
    }

    const candidate = current ? `${current} ${word}` : word;
    if (textWidth(candidate) > maxWidth && current) {
      lines.push(current);
      current = word;
    } else {
      current = candidate;
    }
  }
  if (current) lines.push(current);
  return lines;
}

function layoutLabelBox(boxTop: number, titleText: string, subtitleText: string) {
  const titleLines = wrapLabel(titleText, TITLE_MAX_CHARS);
  const subtitleLines = wrapLabel(subtitleText, SUBTITLE_MAX_CHARS);
  const titleFirstY = boxTop + BOX_FIRST_LINE_OFFSET;
  const titleLastY = titleFirstY + (titleLines.length - 1) * TITLE_LINE_HEIGHT;
  const subtitleFirstY = titleLastY + TITLE_TO_SUBTITLE_GAP;
  const subtitleLastY = subtitleFirstY + (subtitleLines.length - 1) * SUBTITLE_LINE_HEIGHT;
  const height = Math.max(BOX_MIN_HEIGHT, subtitleLastY - boxTop + BOX_BOTTOM_PADDING);
  return { titleLines, subtitleLines, titleFirstY, subtitleFirstY, height };
}

// The PRIVATE/PUBLIC KEY box stacks a (possibly multi-line, bold, uppercase)
// title, a fixed key icon, then a (possibly multi-line) caption. The title
// pushes the icon down when it wraps, and the icon pushes the caption down
// in turn, so the two boxes need a shared icon row to stay lined up with
// the "linked" connector between them.
const KEY_BOX_TOP = 48;
const KEY_TITLE_MAX_CHARS = 13;
const KEY_TITLE_FIRST_OFFSET = 28;
const KEY_TITLE_TO_ICON_GAP = 50;
const KEY_ICON_TO_CAPTION_GAP = 50;
const KEY_CAPTION_BOTTOM_PADDING = 34;
const KEY_BOX_MIN_HEIGHT = 190;

function layoutKeyTitle(titleText: string) {
  const titleLines = wrapLabel(titleText, KEY_TITLE_MAX_CHARS);
  const titleFirstY = KEY_BOX_TOP + KEY_TITLE_FIRST_OFFSET;
  const titleLastY = titleFirstY + (titleLines.length - 1) * TITLE_LINE_HEIGHT;
  return { titleLines, titleFirstY, titleLastY };
}

function layoutKeyCaption(captionText: string, iconCenterY: number) {
  const captionLines = wrapLabel(captionText, SUBTITLE_MAX_CHARS);
  const captionFirstY = iconCenterY + KEY_ICON_TO_CAPTION_GAP;
  const captionLastY = captionFirstY + (captionLines.length - 1) * SUBTITLE_LINE_HEIGHT;
  return { captionLines, captionFirstY, captionLastY };
}

const privateTitle = layoutKeyTitle(w.diagram.privateKeyLabel);
const publicTitle = layoutKeyTitle(w.diagram.publicKeyLabel);
// Shared so both key icons — and the "linked" connector between them — stay level.
const keyIconCenterY = Math.max(privateTitle.titleLastY, publicTitle.titleLastY) + KEY_TITLE_TO_ICON_GAP;

const privateCaption = layoutKeyCaption(w.diagram.private, keyIconCenterY);
const publicCaption = layoutKeyCaption(w.diagram.public, keyIconCenterY);
const keyBoxHeight = Math.max(
  KEY_BOX_MIN_HEIGHT,
  privateCaption.captionLastY - KEY_BOX_TOP + KEY_CAPTION_BOTTOM_PADDING,
  publicCaption.captionLastY - KEY_BOX_TOP + KEY_CAPTION_BOTTOM_PADDING
);
const keyBoxBottom = KEY_BOX_TOP + keyBoxHeight;
const ARROW_GAP = 30;
const labelBoxTop = keyBoxBottom + ARROW_GAP;

const deviceBox = layoutLabelBox(labelBoxTop, `📱 ${w.diagram.device.title}`, w.diagram.device.subtitle);
const websiteBox = layoutLabelBox(labelBoxTop, `🌐 ${w.diagram.website.title}`, w.diagram.website.subtitle);
const labelBoxHeight = Math.max(deviceBox.height, websiteBox.height);
const svgHeight = Math.max(340, labelBoxTop + labelBoxHeight + 22);
---
<section id="what-is" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-linear-to-br from-indigo-50 to-white dark:from-indigo-950 dark:to-gray-900">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{w.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-6">
        {w.headline}
      </h2>
      <RichText class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed mb-10" text={w.body} />
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        {(['staysWithYou', 'websiteGetsKey', 'workTogether'] as const).map((key, i) => (
          <div class={`fade-in-section flex gap-4`} style={`transition-delay: ${i * 0.15}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg">
              {i + 1}
            </div>
            <div>
              <h3 class="font-bold text-gray-900 dark:text-gray-50 mb-1">{w.highlights[key].title}</h3>
              <RichText class="text-gray-600 dark:text-gray-400 leading-relaxed" text={w.highlights[key].body} />
            </div>
          </div>
        ))}
      </div>

      <!-- Key pair illustration -->
      <div class="fade-in-section flex justify-center" style="transition-delay: 0.3s">
        <svg viewBox={`0 0 320 ${svgHeight}`} class="w-full max-w-xs" aria-label={w.illustrationAlt} role="img">
          <!-- Title -->
          <text x="160" y="26" text-anchor="middle" font-family="system-ui, sans-serif" font-size="13" font-weight="600" class="fill-gray-500 dark:fill-gray-400">{w.diagram.title}</text>

          <!-- Private key (device) -->
          <rect x="20" y="48" width="130" height={keyBoxHeight} rx="20" fill="#4f46e5" opacity="0.1" stroke="#4f46e5" stroke-width="1.5"/>
          <text x="85" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" class="fill-indigo-600 dark:fill-indigo-300">
            {privateTitle.titleLines.map((line, i) => (
              <tspan x="85" y={privateTitle.titleFirstY + i * TITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>
          <!-- Key SVG (private, hidden) -->
          <g transform={`translate(66, ${keyIconCenterY})`}>
            <circle cx="0" cy="0" r="22" fill="#4f46e5" opacity="0.08"/>
            <circle cx="0" cy="0" r="15" fill="#4f46e5"/>
            <circle cx="0" cy="0" r="6" fill="#f8f7ff"/>
            <rect x="12" y="-5" width="34" height="10" rx="2.5" fill="#4f46e5"/>
            <rect x="39" y="3" width="7" height="11" rx="2" fill="#4f46e5"/>
            <g transform="translate(-11, 13)">
              <circle r="9.5" fill="#f8f7ff" stroke="#4f46e5" stroke-width="1.5"/>
              <ellipse cx="0" cy="0" rx="5.2" ry="3" fill="none" stroke="#4f46e5" stroke-width="1.4"/>
              <circle cx="0" cy="0" r="1.4" fill="#4f46e5"/>
              <line x1="-5.5" y1="4.5" x2="5.5" y2="-4.5" stroke="#4f46e5" stroke-width="1.6" stroke-linecap="round"/>
            </g>
          </g>
          <text x="85" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" class="fill-indigo-600 dark:fill-indigo-300">
            {privateCaption.captionLines.map((line, i) => (
              <tspan x="85" y={privateCaption.captionFirstY + i * SUBTITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>

          <!-- Link -->
          <line x1="150" y1={keyIconCenterY} x2="170" y2={keyIconCenterY} stroke="#059669" stroke-width="2.5" stroke-dasharray="5,3" stroke-linecap="round"/>
          <text x="160" y={keyIconCenterY - 10} text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" font-weight="700" class="fill-emerald-700 dark:fill-emerald-300">{w.diagram.linked}</text>

          <!-- Public key (website) -->
          <rect x="170" y="48" width="130" height={keyBoxHeight} rx="20" fill="#10b981" opacity="0.1" stroke="#10b981" stroke-width="1.5"/>
          <text x="235" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" class="fill-emerald-700 dark:fill-emerald-300">
            {publicTitle.titleLines.map((line, i) => (
              <tspan x="235" y={publicTitle.titleFirstY + i * TITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>
          <!-- Key SVG (public, visible) -->
          <g transform={`translate(216, ${keyIconCenterY})`}>
            <circle cx="0" cy="0" r="22" fill="#10b981" opacity="0.08"/>
            <circle cx="0" cy="0" r="15" fill="#10b981"/>
            <circle cx="0" cy="0" r="6" fill="#f0fdf4"/>
            <rect x="12" y="-5" width="34" height="10" rx="2.5" fill="#10b981"/>
            <rect x="39" y="3" width="7" height="11" rx="2" fill="#10b981"/>
            <g transform="translate(-11, 13)">
              <circle r="9.5" fill="#f0fdf4" stroke="#10b981" stroke-width="1.5"/>
              <ellipse cx="0" cy="0" rx="5.2" ry="3" fill="none" stroke="#059669" stroke-width="1.4"/>
              <circle cx="0" cy="0" r="1.4" fill="#059669"/>
            </g>
          </g>
          <text x="235" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" class="fill-emerald-700 dark:fill-emerald-300">
            {publicCaption.captionLines.map((line, i) => (
              <tspan x="235" y={publicCaption.captionFirstY + i * SUBTITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>

          <!-- Device box -->
          <rect x="20" y={labelBoxTop} width="130" height={labelBoxHeight} rx="12" fill="#f8f7ff" stroke="#e0e7ff" stroke-width="1.5"/>
          <text x="85" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#4f46e5">
            {deviceBox.titleLines.map((line, i) => (
              <tspan x="85" y={deviceBox.titleFirstY + i * TITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>
          <text x="85" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#6b7280">
            {deviceBox.subtitleLines.map((line, i) => (
              <tspan x="85" y={deviceBox.subtitleFirstY + i * SUBTITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>

          <!-- Website box -->
          <rect x="170" y={labelBoxTop} width="130" height={labelBoxHeight} rx="12" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1.5"/>
          <text x="235" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="600" fill="#047857">
            {websiteBox.titleLines.map((line, i) => (
              <tspan x="235" y={websiteBox.titleFirstY + i * TITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>
          <text x="235" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#6b7280">
            {websiteBox.subtitleLines.map((line, i) => (
              <tspan x="235" y={websiteBox.subtitleFirstY + i * SUBTITLE_LINE_HEIGHT}>{line}</tspan>
            ))}
          </text>

          <!-- Arrows -->
          <line x1="85" y1={keyBoxBottom} x2="85" y2={labelBoxTop} stroke="#c7d2fe" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
          <line x1="235" y1={keyBoxBottom} x2="235" y2={labelBoxTop} stroke="#bbf7d0" stroke-width="1.5" marker-end="url(#arrowGreen)"/>

          <defs>
            <marker id="arrowBlue" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
              <path d="M0,0 L0,8 L8,4 z" fill="#c7d2fe"/>
            </marker>
            <marker id="arrowGreen" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
              <path d="M0,0 L0,8 L8,4 z" fill="#bbf7d0"/>
            </marker>
          </defs>
        </svg>
      </div>
    </div>

    <!-- Technical callout -->
    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 dark:text-indigo-300 mb-3">
        <Code2 size={16} />
        {t.common.technicalDetail}
      </p>
      <h3 class="text-xl font-bold text-indigo-900 dark:text-indigo-200 mb-3">{w.techCallout.headline}</h3>
      <RichText class="text-indigo-800 dark:text-indigo-300 leading-relaxed" text={w.techCallout.body} />
      <TechCalloutLinks links={w.techCallout.additionalLinks} t={t} />
    </div>
  </div>
</section>
