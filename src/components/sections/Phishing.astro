---
import { Check, AlertTriangle, ShieldX, ShieldCheck, Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const p = t.phishing;
---
<section id="phishing" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white dark:bg-gray-900">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{p.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-6">
        {p.headline}
      </h2>
      <RichText class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed" text={p.body} />
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <div class="fade-in-section space-y-3 mb-8" style="transition-delay: 0.2s">
          <p class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">{p.example.label}</p>

          <div class="flex items-center gap-3 bg-green-50 dark:bg-green-950/40 border border-green-200 dark:border-green-800 rounded-xl px-4 py-3">
            <Check size={18} class="text-green-600 dark:text-green-400 shrink-0" />
            <span class="font-mono font-semibold text-green-800 dark:text-green-300">{p.example.real}</span>
            <span class="ml-auto text-xs text-green-700 dark:text-green-400 font-semibold">{p.diagram.realBadge}</span>
          </div>

          <div class="flex items-center gap-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 rounded-xl px-4 py-3">
            <AlertTriangle size={18} class="text-red-600 dark:text-red-400 shrink-0" />
            <span class="font-mono font-semibold text-red-800 dark:text-red-300">{p.example.fake}</span>
            <span class="ml-auto text-xs text-red-700 dark:text-red-300 font-semibold">{p.diagram.fakeBadge}</span>
          </div>
        </div>

        <div class="fade-in-section rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 p-6 mb-8" style="transition-delay: 0.25s">
          <h3 id="phishing-resistance" class="text-lg font-bold text-emerald-900 dark:text-emerald-200 mb-2 scroll-mt-24">{p.resistance.headline}</h3>
          <RichText class="text-emerald-800 dark:text-emerald-300 leading-relaxed text-sm mb-4" text={p.resistance.body} />
          <div class="grid grid-cols-2 gap-3">
            <div class="flex items-center gap-2 bg-white dark:bg-gray-800 border border-emerald-200 dark:border-emerald-800 rounded-xl px-3 py-2">
              <ShieldCheck size={18} class="text-emerald-600 dark:text-emerald-400 shrink-0" />
              <span class="text-sm text-emerald-700 dark:text-emerald-300 font-medium">{p.resistance.real.label}:<br>{p.resistance.real.result}</span>
            </div>
            <div class="flex items-center gap-2 bg-white dark:bg-gray-800 border border-red-200 dark:border-red-800 rounded-xl px-3 py-2">
              <ShieldX size={18} class="text-red-500 dark:text-red-400 shrink-0" />
              <span class="text-sm text-red-600 dark:text-red-400 font-medium">{p.resistance.fake.label}:<br>{p.resistance.fake.result}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Phishing diagram -->
      <div class="fade-in-section flex justify-center" style="transition-delay: 0.3s">
        <div class="w-full max-w-xs flex flex-col items-center gap-1" aria-label={p.illustrationAlt} role="img">
          <!-- User -->
          <div class="flex flex-col items-center mb-1">
            <div class="w-14 h-14 rounded-full bg-indigo-100 dark:bg-indigo-950 flex items-center justify-center">
              <svg viewBox="0 0 40 44" class="w-8 h-8" aria-hidden="true">
                <circle cx="20" cy="14" r="10" fill="#6366f1" opacity="0.6"/>
                <path d="M4 40 Q20 30 36 40" fill="#6366f1" opacity="0.4"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-1">{p.diagram.youLabel}</p>
          </div>

          <!-- Arrow down -->
          <div class="flex flex-col items-center">
            <div class="w-0.5 h-5 bg-red-400"></div>
            <div class="border-l-[5px] border-r-[5px] border-t-[7px] border-l-transparent border-r-transparent border-t-red-400"></div>
          </div>

          <!-- Fake site -->
          <div class="w-full rounded-2xl border-2 border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950/40 p-4">
            <p class="font-bold text-red-700 dark:text-red-300 text-center text-base">{p.diagram.fakeSiteLabel}</p>
            <p class="font-mono text-xs text-red-700 dark:text-red-300 text-center mt-1">{p.example.fake}</p>
            <div class="mt-3 bg-white dark:bg-gray-800 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2 text-sm text-gray-500 dark:text-gray-400 italic text-center">
              {p.diagram.passwordPlaceholder}
            </div>
          </div>

          <!-- Arrow down -->
          <div class="flex flex-col items-center">
            <div class="w-0.5 h-5 bg-red-400"></div>
            <div class="border-l-[5px] border-r-[5px] border-t-[7px] border-l-transparent border-r-transparent border-t-red-400"></div>
          </div>

          <!-- Attacker -->
          <div class="rounded-xl bg-gray-800 dark:bg-black px-5 py-3 text-center min-w-36">
            <p class="font-bold text-white text-sm">{p.diagram.attackerLabel}</p>
            <p class="text-red-300 text-xs mt-0.5">{p.diagram.attackerCaption}</p>
          </div>

          <!-- Arrow down + left -->
          <div class="flex flex-col items-center">
            <div class="w-0.5 h-5 bg-red-400"></div>
            <div class="border-l-[5px] border-r-[5px] border-t-[7px] border-l-transparent border-r-transparent border-t-red-400"></div>
          </div>

          <!-- Real site -->
          <div class="w-full rounded-2xl border-2 border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 p-4">
            <p class="font-bold text-emerald-700 dark:text-emerald-300 text-center text-base">{p.diagram.realSiteLabel}</p>
            <p class="font-mono text-sm text-emerald-700 dark:text-emerald-300 text-center mt-1">{p.example.real}</p>
            <p class="text-sm font-semibold text-red-600 dark:text-red-400 text-center mt-2">{p.diagram.signedInAsYou}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 dark:text-indigo-300 mb-3">
        <Code2 size={16} />
        {t.common.technicalDetail}
      </p>
      <h3 id="phishing-tech-callout" class="text-xl font-bold text-indigo-900 dark:text-indigo-200 mb-3 scroll-mt-24">{p.techCallout.headline}</h3>
      <RichText class="text-indigo-800 dark:text-indigo-300 leading-relaxed" text={p.techCallout.body} />
      <TechCalloutLinks links={p.techCallout.additionalLinks} t={t} />
    </div>
  </div>
</section>
