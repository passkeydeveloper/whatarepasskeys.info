---
import { KeyRound } from 'lucide-astro';

interface Props {
  t: any;
}
const { t } = Astro.props;

const jumpLinks = [
  { id: 'what-is', label: t.hero.jumpLinks.whatIs },
  { id: 'how-it-works', label: t.hero.jumpLinks.howItWorks },
  { id: 'why-passwords-fail', label: t.hero.jumpLinks.whyPasswordsFail },
  { id: 'phishing', label: t.hero.jumpLinks.phishing },
  { id: 'comparison', label: t.hero.jumpLinks.comparison },
  { id: 'credential-managers', label: t.hero.jumpLinks.credentialManagers },
  { id: 'work-passkeys', label: t.hero.jumpLinks.workPasskeys },
  { id: 'faq', label: t.hero.jumpLinks.faq },
];
---
<section id="hero" class="min-h-screen flex flex-col justify-center pt-24 sm:pt-20 px-6 bg-linear-to-br from-indigo-50 via-white to-emerald-50 dark:from-indigo-950 dark:via-gray-900 dark:to-emerald-950 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-100 dark:bg-indigo-600 rounded-full blur-3xl opacity-40 dark:opacity-20"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-emerald-100 dark:bg-emerald-600 rounded-full blur-3xl opacity-40 dark:opacity-20"></div>
  </div>

  <div class="max-w-5xl mx-auto w-full relative z-10">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="fade-in-section">
        <div class="inline-flex items-center gap-2 bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 rounded-full px-4 py-1.5 text-sm font-semibold mb-6">
          <KeyRound size={14} />
          <h1>{t.hero.eyebrow}</h1>
        </div>
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-6">
          {t.hero.headline}
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 leading-relaxed mb-10">
          {t.hero.subheadline}
        </p>
        <a
          href="#what-is"
          class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl px-8 py-4 text-lg transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5"
        >
          {t.hero.scrollCta}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <!-- Hero illustration -->
      <div class="fade-in-section flex justify-center" style="transition-delay: 0.2s">
        <svg viewBox="0 0 400 400" class="w-full max-w-sm" aria-label={t.hero.illustrationAlt} role="img">
          <title>{t.hero.illustrationAlt}</title>
          <!-- Phone -->
          <rect x="130" y="60" width="140" height="240" rx="20" fill="#4f46e5" opacity="0.12"/>
          <rect x="135" y="65" width="130" height="230" rx="17" fill="#f8f7ff"/>
          <!-- Screen content -->
          <rect x="155" y="95" width="90" height="8" rx="4" fill="#e0e7ff"/>
          <rect x="165" y="112" width="70" height="6" rx="3" fill="#c7d2fe"/>
          <!-- Face ID rings -->
          <circle cx="200" cy="180" r="42" fill="none" stroke="#4f46e5" stroke-width="2.5" opacity="0.3"/>
          <circle cx="200" cy="180" r="32" fill="none" stroke="#4f46e5" stroke-width="2" opacity="0.5"/>
          <!-- Face -->
          <circle cx="200" cy="180" r="22" fill="#4f46e5" opacity="0.15"/>
          <circle cx="193" cy="176" r="3" fill="#4f46e5" opacity="0.7"/>
          <circle cx="207" cy="176" r="3" fill="#4f46e5" opacity="0.7"/>
          <path d="M191 186 Q200 193 209 186" stroke="#4f46e5" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.7"/>
          <!-- Checkmark / unlock indicator -->
          <circle cx="200" cy="250" r="14" fill="#10b981" opacity="0.9"/>
          <path d="M194 250 l4 4 8-8" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Key icon floating -->
          <g transform="translate(290, 140) rotate(-30)">
            <circle cx="0" cy="0" r="14" fill="#f59e0b" opacity="0.9"/>
            <rect x="8" y="-4" width="22" height="8" rx="4" fill="#f59e0b" opacity="0.9"/>
            <rect x="24" y="4" width="6" height="7" rx="2" fill="#d97706"/>
          </g>
          <!-- Lock icon floating -->
          <g transform="translate(95, 160)">
            <rect x="-14" y="-6" width="28" height="22" rx="5" fill="#4f46e5" opacity="0.8"/>
            <path d="M-7 -6 Q-7 -18 0 -18 Q7 -18 7 -6" stroke="#4f46e5" stroke-width="4" fill="none" opacity="0.8" stroke-linecap="round"/>
            <circle cx="0" cy="5" r="4" fill="white" opacity="0.8"/>
          </g>
        </svg>
      </div>
    </div>

    <nav aria-label={t.nav.jumpToSection} class="flex flex-wrap justify-center gap-2 mt-16 fade-in-section" style="transition-delay: 0.3s">
      {jumpLinks.map(link => (
        <a
          href={`#${link.id}`}
          class="text-xs font-medium text-gray-500 dark:text-gray-300 hover:text-indigo-700 dark:hover:text-indigo-300 bg-white/70 dark:bg-gray-800/70 hover:bg-indigo-50 dark:hover:bg-indigo-950 border border-gray-200 dark:border-gray-600 hover:border-indigo-200 dark:hover:border-indigo-800 rounded-full px-3 py-1 transition-colors duration-150"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex justify-center mt-6 fade-in-section" style="transition-delay: 0.4s">
      <div class="flex flex-col items-center gap-2 text-gray-500 dark:text-gray-300 text-sm">
        <span>{t.hero.scrollIndicator}</span>
        <svg class="animate-bounce" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </div>
</section>
