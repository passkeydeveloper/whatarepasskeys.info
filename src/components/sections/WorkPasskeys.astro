---
import { Briefcase } from 'lucide-astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const w = t.workPasskeys;
---
<section id="work-passkeys" class="min-h-screen flex flex-col justify-center items-center py-24 px-6 bg-white text-center">
  <div class="max-w-2xl mx-auto w-full">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{w.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {w.headline}
      </h2>
      <div class="inline-flex flex-col items-center gap-3 rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-8 py-10">
        <Briefcase size={28} class="text-gray-400" />
        <p class="text-gray-500 leading-relaxed">{w.placeholderNote}</p>
      </div>
    </div>
  </div>
</section>
