---
import { Home, Building2, ShieldCheck, Usb, KeyRound, Lock, Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const w = t.workPasskeys;

const highlightKeys = ['choice', 'extraSteps', 'differentLook'] as const;

const exampleChips = [
  { key: 'managedDevice', icon: ShieldCheck },
  { key: 'securityKey', icon: Usb },
  { key: 'brandedSignIn', icon: Building2 },
  { key: 'deviceBound', icon: Lock },
] as const;
---
<section id="work-passkeys" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{w.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {w.headline}
      </h2>
      <RichText class="text-xl text-gray-600 leading-relaxed" text={w.intro} />
    </div>

    <!-- Numbered highlights -->
    <div class="grid md:grid-cols-3 gap-6 mb-16">
      {highlightKeys.map((key, i) => (
        <div class="fade-in-section flex gap-4" style={`transition-delay: ${i * 0.12}s`}>
          <div class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg">
            {i + 1}
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">{w.highlights[key].title}</h3>
            <RichText class="text-gray-600 leading-relaxed text-sm" text={w.highlights[key].body} />
          </div>
        </div>
      ))}
    </div>

    <!-- Personal vs. work comparison -->
    <div class="fade-in-section mb-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-2">{w.compare.sectionLabel}</p>
      <h3 class="text-2xl md:text-3xl font-extrabold leading-tight tracking-tight text-gray-900 mb-8">
        {w.compare.headline}
      </h3>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="shrink-0 w-10 h-10 rounded-xl bg-gray-200 flex items-center justify-center">
              <Home size={20} class="text-gray-600" />
            </span>
            <div>
              <h4 class="font-bold text-gray-900">{w.compare.personal.label}</h4>
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">{w.compare.personal.caption}</p>
            </div>
          </div>
          <ul class="space-y-3">
            {w.compare.personal.items.map((item: string) => (
              <li class="flex items-start gap-2 text-sm text-gray-600 leading-relaxed">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-gray-400 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center">
              <Building2 size={20} class="text-white" />
            </span>
            <div>
              <h4 class="font-bold text-indigo-900">{w.compare.work.label}</h4>
              <p class="text-xs font-semibold uppercase tracking-wide text-indigo-400">{w.compare.work.caption}</p>
            </div>
          </div>
          <ul class="space-y-3">
            {w.compare.work.items.map((item: string) => (
              <li class="flex items-start gap-2 text-sm text-indigo-900 leading-relaxed">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Examples chips -->
    <div class="fade-in-section mb-4">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-5">{w.examples.sectionLabel}</p>
      <div class="flex flex-wrap gap-3">
        {exampleChips.map(({ key, icon: Icon }) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700">
            <Icon size={16} class="text-indigo-600" />
            {w.examples.items[key].label}
          </span>
        ))}
      </div>
    </div>

    <!-- Technical callout -->
    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
        <Code2 size={16} />
        {t.common.technicalDetail}
      </p>
      <h3 class="text-xl font-bold text-indigo-900 mb-3">{w.techCallout.headline}</h3>
      <RichText class="text-indigo-800 leading-relaxed" text={w.techCallout.body} />
      <TechCalloutLinks links={w.techCallout.additionalLinks} t={t} />
    </div>
  </div>
</section>
