---
import { siApple, siGoogle, si1password, siBitwarden, siDashlane } from 'simple-icons';
import { Code2, Lock } from 'lucide-astro';
import SimpleIcon from '../SimpleIcon.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const cm = t.credentialManagers;

const managers = [
  { key: 'apple',      si: siApple,      bg: 'bg-gray-50',    border: 'border-gray-200' },
  { key: 'google',     si: siGoogle,     bg: 'bg-blue-50',    border: 'border-blue-200' },
  { key: '1password',  si: si1password,  bg: 'bg-blue-50',    border: 'border-blue-200' },
  { key: 'bitwarden',  si: siBitwarden,  bg: 'bg-indigo-50',  border: 'border-indigo-200' },
  { key: 'dashlane',   si: siDashlane,   bg: 'bg-emerald-50', border: 'border-emerald-200' },
  { key: 'nordpass',   si: null,         bg: 'bg-teal-50',    border: 'border-teal-200'  },
] as const;

const criteria: string[] = cm.scoring.criteria;
---
<section id="credential-managers" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{cm.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {cm.headline}
      </h2>
      <p class="text-xl text-gray-600 leading-relaxed max-w-3xl mb-4">{cm.intro}</p>
      <p class="text-lg text-gray-500 leading-relaxed max-w-3xl mb-4">{cm.platformNote}</p>
      <p class="text-lg text-gray-500 leading-relaxed max-w-3xl">{cm.convenienceNote}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      {managers.map((manager, i) => {
        const data = (cm.managers as any)[manager.key];
        return (
          <div
            class={`fade-in-section manager-card rounded-2xl border ${manager.border} ${manager.bg} p-5`}
            style={`transition-delay: ${i * 0.08}s`}
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="flex-shrink-0">
                {manager.si ? (
                  <SimpleIcon path={manager.si.path} hex={manager.si.hex} title={manager.si.title} size={24} />
                ) : (
                  <Lock size={24} class="text-teal-600" />
                )}
              </span>
              <h3 class="font-bold text-gray-900">{data.name}</h3>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed">{data.description}</p>
          </div>
        );
      })}
    </div>

    <!-- Scoring -->
    <div class="fade-in-section mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{cm.scoring.sectionLabel}</p>
      <h3 class="text-3xl md:text-4xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {cm.scoring.headline}
      </h3>
      <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mb-3">{cm.scoring.intro}</p>
      <p class="text-base text-gray-500 leading-relaxed max-w-3xl mb-8">{cm.scoring.methodologyIntro}</p>
    </div>

    <div class="fade-in-section overflow-x-auto mb-4">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="text-left py-3 px-4 text-sm text-gray-500 font-semibold border-b border-gray-200"></th>
            {managers.map((manager) => (
              <th class="text-center py-3 px-3 text-xs font-bold text-gray-700 border-b border-gray-200">
                {(cm.managers as any)[manager.key].name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {criteria.map((criterion, ri) => (
            <tr class={ri % 2 === 0 ? 'bg-gray-50/50' : 'bg-white'}>
              <td class="py-3 px-4 text-sm text-gray-600 font-medium border-b border-gray-100">
                {criterion}
              </td>
              {managers.map((manager) => (
                <td class="py-3 px-3 text-center border-b border-gray-100">
                  <span class="inline-flex items-center justify-center rounded-full border border-dashed border-gray-300 bg-gray-50 text-gray-400 text-xs font-semibold px-2.5 py-1">
                    TBD
                  </span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fade-in-section text-sm text-gray-400 italic mb-12">{cm.scoring.placeholderNote}</p>

    <div class="technical-only space-y-4">
      <div class="fade-in-section rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
        <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
          <Code2 size={16} />
          Technical detail
        </p>
        <h3 class="text-xl font-bold text-indigo-900 mb-3">{cm.techCallout.headline}</h3>
        <p class="text-indigo-800 leading-relaxed mb-6">{cm.techCallout.body}</p>
        <h3 class="text-xl font-bold text-indigo-900 mb-3">{cm.techCallout.headline2}</h3>
        <p class="text-indigo-800 leading-relaxed">{cm.techCallout.bodyHardware}</p>
      </div>
    </div>
  </div>
</section>
