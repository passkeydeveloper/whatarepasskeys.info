---
import { Code2, ChevronDown, ChevronRight, Info, X } from 'lucide-astro';
import HarveyBall from '../HarveyBall.astro';
import ScoreBall from '../ScoreBall.astro';
import ManagerIcon from '../ManagerIcon.astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';
import { criteria, managerScores, GENERAL_CAVEAT_ID, type ScoreValue, type Grade } from '../../data/credentialManagers';
import { lastGitCommitDate } from '../../utils/gitDate';
import { bcp47Language } from '../../i18n/utils';

interface Props {
  t: any;
  locale: string;
}
const { t, locale } = Astro.props;
const cm = t.credentialManagers;

// The scoring data (src/data/credentialManagers.json) is edited independently
// of, and far less often than, the rest of the page content, so it gets its
// own freshness date rather than sharing the page-wide one in Footer.astro.
const scoresUpdated = lastGitCommitDate('src/data/credentialManagers.json');
const scoresUpdatedFormatted = scoresUpdated
  ? new Intl.DateTimeFormat(bcp47Language(locale), { year: 'numeric', month: 'short', day: 'numeric' }).format(
      new Date(scoresUpdated)
    )
  : null;

// Card styling for the intro grid. Add a row here for each new credential
// manager; the scoring table/cards below pull automatically from
// src/data/credentialManagers.ts.
const managers = [
  { key: 'apple',      bg: 'bg-gray-50 dark:bg-gray-800',       border: 'border-gray-200 dark:border-gray-700' },
  { key: 'google',     bg: 'bg-blue-50 dark:bg-blue-950/30',    border: 'border-blue-200 dark:border-blue-800' },
  { key: '1password',  bg: 'bg-blue-50 dark:bg-blue-950/30',    border: 'border-blue-200 dark:border-blue-800' },
  { key: 'bitwarden',  bg: 'bg-indigo-50 dark:bg-indigo-950/30',  border: 'border-indigo-200 dark:border-indigo-800' },
  { key: 'dashlane',   bg: 'bg-emerald-50 dark:bg-emerald-950/30', border: 'border-emerald-200 dark:border-emerald-800' },
  { key: 'microsoft',  bg: 'bg-teal-50 dark:bg-teal-950/30',    border: 'border-teal-200 dark:border-teal-800' },
  { key: 'nordpass',   bg: 'bg-teal-50 dark:bg-teal-950/30',    border: 'border-teal-200 dark:border-teal-800' },
  { key: 'keeper',     bg: 'bg-amber-50 dark:bg-amber-950/30',   border: 'border-amber-200 dark:border-amber-800' },
  { key: 'protonpass', bg: 'bg-purple-50 dark:bg-purple-950/30',  border: 'border-purple-200 dark:border-purple-800' },
  { key: 'lastpass',   bg: 'bg-red-50 dark:bg-red-950/30',     border: 'border-red-200 dark:border-red-800' },
  { key: 'samsungpass', bg: 'bg-sky-50 dark:bg-sky-950/30',    border: 'border-sky-200 dark:border-sky-800' },
  { key: 'keepassxc',  bg: 'bg-green-50 dark:bg-green-950/30',   border: 'border-green-200 dark:border-green-800' },
] as const;

const alphabeticalManagers = [...managers].sort((a, b) =>
  (cm.managers as any)[a.key].name.localeCompare((cm.managers as any)[b.key].name)
);

const coreCriteria = criteria.filter((c) => c.weight === 'core');
const lowerCriteria = criteria.filter((c) => c.weight === 'lower');

function criterionLabel(id: string): { consumerLabel: string; technicalLabel: string } {
  return (cm.scoring.criteria as any)[id];
}

// Defensive re-sort: keeps the ranking correct even if a future entry is
// appended to managerScores out of order.
const rankedManagers = [...managerScores].sort((a, b) => b.weightedScore - a.weightedScore);

function gradeBadgeClass(grade: Grade) {
  switch (grade) {
    case 'A': return 'bg-emerald-600';
    case 'B': return 'bg-teal-500';
    case 'C': return 'bg-amber-500';
    case 'D': return 'bg-orange-500';
    default: return 'bg-red-600';
  }
}

function scoreMeta(value: ScoreValue) {
  if (value === 5) return { type: 'full' as const, color: 'text-emerald-600 dark:text-emerald-400', bg: 'bg-emerald-50 dark:bg-emerald-950/40', label: cm.scoring.scoreLabel5 };
  if (value === 3) return { type: 'half' as const, color: 'text-amber-600 dark:text-amber-400', bg: 'bg-amber-50 dark:bg-amber-950/40', label: cm.scoring.scoreLabel3 };
  return { type: 'quarter' as const, color: 'text-red-600 dark:text-red-400', bg: 'bg-red-50 dark:bg-red-950/40', label: cm.scoring.scoreLabel1 };
}

const managersWithCaveats = rankedManagers.filter((m) => m.caveats && m.caveats.length > 0);

// "What's missing" lists (technical mode only): plain string arrays at
// cm.managers.<key>.whatsMissing.<criterionId>, only meaningful for non-5
// scores. A cell gets a trigger only when its list exists and is non-empty,
// so a locale that hasn't translated a list just shows no trigger.
function whatsMissingFor(managerKey: string, criterionId: string, value: ScoreValue): string[] | undefined {
  if (value === 5) return undefined;
  const list = (cm.managers as any)[managerKey]?.whatsMissing?.[criterionId];
  return Array.isArray(list) && list.length > 0 ? list : undefined;
}

function whatsMissingTrigger(managerKey: string, criterionId: string, value: ScoreValue, decorative = false) {
  if (!whatsMissingFor(managerKey, criterionId, value)) return undefined;
  return {
    manager: managerKey,
    criterion: criterionId,
    ariaLabel: cm.scoring.whatsMissingTriggerLabel
      .replace('{manager}', (cm.managers as any)[managerKey].name)
      .replace('{criterion}', criterionLabel(criterionId).technicalLabel),
    decorative,
  };
}

// Serialized for the dialog script: { [managerKey]: { [criterionId]: string[] } }
const whatsMissingData: Record<string, Record<string, string[]>> = {};
for (const m of rankedManagers) {
  for (const c of criteria) {
    const list = whatsMissingFor(m.key, c.id, m.scores[c.id]);
    if (list) (whatsMissingData[m.key] ??= {})[c.id] = list;
  }
}
const hasWhatsMissing = Object.keys(whatsMissingData).length > 0;
const whatsMissingMeta = {
  managers: Object.fromEntries(rankedManagers.map((m) => [m.key, (cm.managers as any)[m.key].name])),
  criteria: Object.fromEntries(criteria.map((c) => [c.id, criterionLabel(c.id).technicalLabel])),
  scores: Object.fromEntries(rankedManagers.map((m) => [m.key, m.scores])),
  scoreLabels: { 3: cm.scoring.scoreLabel3, 1: cm.scoring.scoreLabel1 },
  lists: whatsMissingData,
};
---
<section id="credential-managers" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white dark:bg-gray-900">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{cm.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-6">
        {cm.headline}
      </h2>
      <RichText class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed mb-4" text={cm.intro} />
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      {alphabeticalManagers.map((manager, i) => {
        const data = (cm.managers as any)[manager.key];
        return (
          <div
            class={`fade-in-section manager-card rounded-2xl border ${manager.border} ${manager.bg} p-5`}
            style={`transition-delay: ${i * 0.08}s`}
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="shrink-0">
                <ManagerIcon managerKey={manager.key} size={24} />
              </span>
              <h3 id={`credential-managers-${manager.key}`} class="font-bold text-gray-900 dark:text-gray-50 scroll-mt-24">{data.name}</h3>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{data.description}</p>
          </div>
        );
      })}
    </div>

    <!-- Scoring -->
    <div class="fade-in-section mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{cm.scoring.sectionLabel}</p>
      <h3 id="credential-managers-scoring" class="text-3xl md:text-4xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-6 scroll-mt-24">
        {cm.scoring.headline}
      </h3>
      <RichText class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-8" text={cm.scoring.intro} />
    </div>

    <!-- Legend -->
    <div class="fade-in-section flex flex-wrap items-center gap-x-5 gap-y-2 mb-6 text-xs font-semibold text-gray-500 dark:text-gray-400">
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-5 h-5 text-emerald-600 dark:text-emerald-400"><HarveyBall level="full" size={14} /></span>
        {cm.scoring.scoreLabel5}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-5 h-5 text-amber-600 dark:text-amber-400"><HarveyBall level="half" size={14} /></span>
        {cm.scoring.scoreLabel3}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-5 h-5 text-red-600 dark:text-red-400"><HarveyBall level="quarter" size={14} /></span>
        {cm.scoring.scoreLabel1}
      </span>
      {hasWhatsMissing && (
        <span class="technical-only">
          <span class="inline-flex items-center gap-1.5 font-normal">
            <span class="inline-flex items-center justify-center w-5 h-5" aria-hidden="true">
              <span class="w-[5px] h-[5px] rounded-full bg-indigo-500 dark:bg-indigo-400"></span>
            </span>
            {cm.scoring.whatsMissingHint}
          </span>
        </span>
      )}
    </div>

    <!-- Mobile: cards, one per credential manager -->
    <div class="md:hidden space-y-4 mb-4">
      {rankedManagers.map((m) => {
        const data = (cm.managers as any)[m.key];
        return (
          <div class="fade-in-section rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5">
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2 min-w-0">
                <span class="shrink-0"><ManagerIcon managerKey={m.key} size={22} /></span>
                <span class="font-bold text-gray-900 dark:text-gray-50 truncate">{data.name}</span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="relative inline-flex">
                  <span class={`inline-flex items-center justify-center w-9 h-9 rounded-full text-white font-bold ${gradeBadgeClass(m.grade)}`}>
                    {m.grade}
                  </span>
                  {m.caveats?.includes(GENERAL_CAVEAT_ID) && (
                    <a
                      href={`#caveat-${m.key}`}
                      class="absolute -top-1 -right-1 inline-flex items-center justify-center w-4 h-4 rounded-full bg-indigo-600 text-white ring-2 ring-white dark:ring-gray-800 hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
                      aria-label={`${cm.scoring.caveatIndicatorLabel} ${data.name}`}
                    >
                      <Info size={10} stroke-width={3} />
                    </a>
                  )}
                </span>
                <span class="consumer-only text-xs text-gray-600 dark:text-gray-400">{m.weightedScore}/100</span>
                <span class="technical-only text-xs text-gray-600 dark:text-gray-400 font-semibold">{m.weightedScore}/100</span>
              </div>
            </div>
            <div>
              {coreCriteria.map((c) => {
                const value = m.scores[c.id];
                const meta = scoreMeta(value);
                const label = criterionLabel(c.id);
                const trigger = whatsMissingTrigger(m.key, c.id, value);
                return (
                  <div class="flex items-center justify-between gap-3 py-1.5 text-sm border-b border-gray-100 dark:border-gray-700">
                    <div class="min-w-0">
                      <button
                        type="button"
                        class="criterion-jump text-left underline decoration-dotted decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:text-indigo-600 dark:hover:text-indigo-400 hover:decoration-indigo-400 dark:hover:decoration-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                        data-criterion={c.id}
                      >
                        <span class="consumer-only text-gray-600 dark:text-gray-400">{label.consumerLabel}</span>
                        <span class="technical-only text-gray-600 dark:text-gray-400">{label.technicalLabel}</span>
                      </button>
                      {trigger && (
                        <span class="technical-only">
                          <button
                            type="button"
                            class="whats-missing-trigger inline-flex items-center gap-0.5 py-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                            data-manager={m.key}
                            data-criterion={c.id}
                            aria-haspopup="dialog"
                            aria-label={trigger.ariaLabel}
                          >
                            {cm.scoring.whatsMissingLabel}
                            <ChevronRight size={12} stroke-width={2.5} aria-hidden="true" />
                          </button>
                        </span>
                      )}
                    </div>
                    <span class={`inline-flex items-center gap-1 font-semibold shrink-0 ${meta.color}`}>
                      <ScoreBall level={meta.type} colorClass={meta.color} srLabel={meta.label} boxClass="w-5 h-5" trigger={trigger && { ...trigger, decorative: true }} />
                      <span class="technical-only">{value}</span>
                      {m.caveats?.includes(c.id) && (
                        <a
                          href={`#caveat-${m.key}`}
                          class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-indigo-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
                          aria-label={`${cm.scoring.caveatIndicatorLabel} ${data.name}`}
                        >
                          <Info size={10} stroke-width={3} />
                        </a>
                      )}
                    </span>
                  </div>
                );
              })}
              {lowerCriteria.map((c, i) => {
                const value = m.scores[c.id];
                const meta = scoreMeta(value);
                const label = criterionLabel(c.id);
                const trigger = whatsMissingTrigger(m.key, c.id, value);
                return (
                  <div class={`flex items-center justify-between gap-3 py-1.5 text-sm border-b border-gray-100 dark:border-gray-700 last:border-0 ${i === 0 ? 'mt-1' : ''}`}>
                    <div class="min-w-0">
                      <button
                        type="button"
                        class="criterion-jump text-left underline decoration-dotted decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:text-indigo-600 dark:hover:text-indigo-400 hover:decoration-indigo-400 dark:hover:decoration-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                        data-criterion={c.id}
                      >
                        <span class="consumer-only text-gray-500 dark:text-gray-400">{label.consumerLabel}</span>
                        <span class="technical-only text-gray-500 dark:text-gray-400">{label.technicalLabel}</span>
                      </button>
                      {trigger && (
                        <span class="technical-only">
                          <button
                            type="button"
                            class="whats-missing-trigger inline-flex items-center gap-0.5 py-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                            data-manager={m.key}
                            data-criterion={c.id}
                            aria-haspopup="dialog"
                            aria-label={trigger.ariaLabel}
                          >
                            {cm.scoring.whatsMissingLabel}
                            <ChevronRight size={12} stroke-width={2.5} aria-hidden="true" />
                          </button>
                        </span>
                      )}
                    </div>
                    <span class={`inline-flex items-center gap-1 font-semibold shrink-0 ${meta.color}`}>
                      <ScoreBall level={meta.type} colorClass={meta.color} srLabel={meta.label} boxClass="w-5 h-5" trigger={trigger && { ...trigger, decorative: true }} />
                      <span class="technical-only">{value}</span>
                      {m.caveats?.includes(c.id) && (
                        <a
                          href={`#caveat-${m.key}`}
                          class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-indigo-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
                          aria-label={`${cm.scoring.caveatIndicatorLabel} ${data.name}`}
                        >
                          <Info size={10} stroke-width={3} />
                        </a>
                      )}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Desktop: table, one row per credential manager -->
    <div class="hidden md:block fade-in-section overflow-x-auto mb-4">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th rowspan={2} class="text-left py-3 px-4 text-sm text-gray-500 dark:text-gray-400 font-semibold border-b border-gray-200 dark:border-gray-700 align-bottom">
              <span class="sr-only">{cm.scoring.managerColumnLabel}</span>
            </th>
            <th rowspan={2} class="text-center py-3 px-3 text-sm text-gray-500 dark:text-gray-400 font-semibold border-b border-gray-200 dark:border-gray-700 align-bottom">
              {cm.scoring.gradeLabel}
            </th>
            <th colspan={coreCriteria.length} class="text-center py-2 px-3 text-xs uppercase tracking-wider text-gray-600 dark:text-gray-400 font-semibold border-b border-gray-100 dark:border-gray-800">
              {cm.scoring.coreGroupLabel}
            </th>
            <th colspan={lowerCriteria.length} class="text-center py-2 px-3 text-xs uppercase tracking-wider text-gray-600 dark:text-gray-400 font-semibold border-b border-gray-100 dark:border-gray-800 border-l-2 border-l-gray-200 dark:border-l-gray-700">
              {cm.scoring.lowerGroupLabel}
            </th>
          </tr>
          <tr>
            {coreCriteria.map((c) => (
              <th class="text-center py-2 px-3 text-xs font-bold text-gray-700 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700 max-w-[7rem]">
                <button
                  type="button"
                  class="criterion-jump inline underline decoration-dotted decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:text-indigo-600 dark:hover:text-indigo-400 hover:decoration-indigo-400 dark:hover:decoration-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                  data-criterion={c.id}
                >
                  <span class="consumer-only">{criterionLabel(c.id).consumerLabel}</span>
                  <span class="technical-only">{criterionLabel(c.id).technicalLabel}</span>
                </button>
              </th>
            ))}
            {lowerCriteria.map((c, i) => (
              <th class={`text-center py-2 px-3 text-xs font-bold text-gray-700 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700 max-w-[7rem] ${i === 0 ? 'border-l-2 border-l-gray-200 dark:border-l-gray-700' : ''}`}>
                <button
                  type="button"
                  class="criterion-jump inline underline decoration-dotted decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:text-indigo-600 dark:hover:text-indigo-400 hover:decoration-indigo-400 dark:hover:decoration-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                  data-criterion={c.id}
                >
                  <span class="consumer-only">{criterionLabel(c.id).consumerLabel}</span>
                  <span class="technical-only">{criterionLabel(c.id).technicalLabel}</span>
                </button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rankedManagers.map((m, ri) => {
            const data = (cm.managers as any)[m.key];
            return (
              <tr class={ri % 2 === 0 ? 'bg-gray-50/50 dark:bg-gray-800/50' : 'bg-white dark:bg-gray-900'}>
                <td class="py-3 px-4 border-b border-gray-100 dark:border-gray-800">
                  <div class="flex items-center gap-2">
                    <span class="shrink-0"><ManagerIcon managerKey={m.key} size={20} /></span>
                    <span class="font-semibold text-gray-900 dark:text-gray-50 text-sm whitespace-nowrap">{data.name}</span>
                  </div>
                </td>
                <td class="py-3 px-3 text-center border-b border-gray-100 dark:border-gray-800">
                  <span class="inline-flex flex-col items-center gap-0.5">
                    <span class="relative inline-flex">
                      <span class={`inline-flex items-center justify-center w-8 h-8 rounded-full text-white font-bold text-sm ${gradeBadgeClass(m.grade)}`}>
                        {m.grade}
                      </span>
                      {m.caveats?.includes(GENERAL_CAVEAT_ID) && (
                        <a
                          href={`#caveat-${m.key}`}
                          class="absolute -top-1 -right-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-indigo-600 text-white ring-2 ring-white dark:ring-gray-900 hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
                          aria-label={`${cm.scoring.caveatIndicatorLabel} ${data.name}`}
                        >
                          <Info size={9} stroke-width={3} />
                        </a>
                      )}
                    </span>
                    <span class="consumer-only text-xs text-gray-600 dark:text-gray-400">{m.weightedScore}/100</span>
                    <span class="technical-only text-xs text-gray-600 dark:text-gray-400 font-semibold">{m.weightedScore}/100</span>
                  </span>
                </td>
                {coreCriteria.map((c) => {
                  const value = m.scores[c.id];
                  const meta = scoreMeta(value);
                  const hasCaveat = m.caveats?.includes(c.id);
                  return (
                    <td class="py-3 px-3 text-center border-b border-gray-100 dark:border-gray-800">
                      <span class="inline-flex flex-col items-center gap-0.5">
                        <span class="relative inline-flex">
                          <ScoreBall level={meta.type} colorClass={meta.color} srLabel={meta.label} trigger={whatsMissingTrigger(m.key, c.id, value)} />
                          {hasCaveat && (
                            <a
                              href={`#caveat-${m.key}`}
                              class="absolute -top-1 -right-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-indigo-600 text-white ring-2 ring-white dark:ring-gray-900 hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
                              aria-label={`${cm.scoring.caveatIndicatorLabel} ${data.name}`}
                            >
                              <Info size={9} stroke-width={3} />
                            </a>
                          )}
                        </span>
                        <span class="technical-only text-xs text-gray-600 dark:text-gray-400">{value}</span>
                      </span>
                    </td>
                  );
                })}
                {lowerCriteria.map((c, i) => {
                  const value = m.scores[c.id];
                  const meta = scoreMeta(value);
                  const hasCaveat = m.caveats?.includes(c.id);
                  return (
                    <td class={`py-3 px-3 text-center border-b border-gray-100 dark:border-gray-800 ${i === 0 ? 'border-l-2 border-l-gray-200 dark:border-l-gray-700' : ''}`}>
                      <span class="inline-flex flex-col items-center gap-0.5">
                        <span class="relative inline-flex">
                          <ScoreBall level={meta.type} colorClass={meta.color} srLabel={meta.label} trigger={whatsMissingTrigger(m.key, c.id, value)} />
                          {hasCaveat && (
                            <a
                              href={`#caveat-${m.key}`}
                              class="absolute -top-1 -right-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full bg-indigo-600 text-white ring-2 ring-white dark:ring-gray-900 hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
                              aria-label={`${cm.scoring.caveatIndicatorLabel} ${data.name}`}
                            >
                              <Info size={9} stroke-width={3} />
                            </a>
                          )}
                        </span>
                        <span class="technical-only text-xs text-gray-600 dark:text-gray-400">{value}</span>
                      </span>
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {scoresUpdatedFormatted && (
      <p class="fade-in-section text-sm text-gray-500 dark:text-gray-400 italic text-right mb-6">
        {cm.scoring.lastUpdated.replace('{date}', scoresUpdatedFormatted)}
      </p>
    )}

    <!-- Caveats -->
    {managersWithCaveats.length > 0 && (
      <div class="fade-in-section rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-6 md:p-8 mb-16">
        <p class="text-sm font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4">{cm.scoring.caveatsLabel}</p>
        <dl class="space-y-5">
          {managersWithCaveats.map((m) => {
            const data = (cm.managers as any)[m.key];
            return (
              <div id={`caveat-${m.key}`} class="scroll-mt-24">
                <dt class="flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-50 text-sm mb-2">
                  <span class="shrink-0"><ManagerIcon managerKey={m.key} size={18} /></span>
                  <span>{data.name}</span>
                </dt>
                <dd class="space-y-2 pl-6">
                  {m.caveats!.map((id) => (
                    <div>
                      {id !== GENERAL_CAVEAT_ID && (
                        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 mb-0.5">
                          <span class="consumer-only">{criterionLabel(id).consumerLabel}</span>
                          <span class="technical-only">{criterionLabel(id).technicalLabel}</span>
                        </p>
                      )}
                      <p class={`text-gray-600 dark:text-gray-400 leading-relaxed ${id === GENERAL_CAVEAT_ID ? 'text-base' : 'text-sm'}`}>{data.caveats[id]}</p>
                    </div>
                  ))}
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    )}

    <!-- Criteria details -->
    <div class="fade-in-section mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{cm.scoring.criteriaDetails.sectionLabel}</p>
      <h3 id="credential-managers-criteria-details" class="text-2xl md:text-3xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-3 scroll-mt-24">
        {cm.scoring.criteriaDetails.headline}
      </h3>
      <RichText class="text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-3xl" text={cm.scoring.criteriaDetails.intro} />
    </div>

    <div class="space-y-0 divide-y divide-gray-100 dark:divide-gray-800 mb-16">
      {criteria.map((c, i) => {
        const detail = (cm.scoring.criteriaDetails.items as any)[c.id];
        const label = criterionLabel(c.id);
        return (
          <details id={`criterion-${c.id}`} class="faq-item fade-in-section scroll-mt-24" style={`transition-delay: ${i * 0.05}s`}>
            <summary>
              <span class="flex items-center gap-2 flex-wrap">
                <span class="consumer-only">{label.consumerLabel}</span>
                <span class="technical-only">{label.technicalLabel}</span>
                <span class={`technical-only text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full ${c.weight === 'core' ? 'bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300' : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'}`}>
                  {c.weight === 'core' ? cm.scoring.coreTag : cm.scoring.lowerTag}
                </span>
              </span>
              <ChevronDown size={20} class="faq-chevron" />
            </summary>
            <div class="pb-5">
              <p class="consumer-only text-gray-600 dark:text-gray-400 leading-relaxed">{detail.consumerBody}</p>
              <div class="technical-only">
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">{detail.technicalBody}</p>
                <ul class="space-y-2 text-sm">
                  <li class="flex items-start gap-2">
                    <span class="inline-flex items-center justify-center w-5 h-5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5"><HarveyBall level="full" size={14} /></span>
                    <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-50 font-semibold">{cm.scoring.scoreLabel5}:</strong> {detail.tier5}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="inline-flex items-center justify-center w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5"><HarveyBall level="half" size={14} /></span>
                    <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-50 font-semibold">{cm.scoring.scoreLabel3}:</strong> {detail.tier3}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="inline-flex items-center justify-center w-5 h-5 text-red-600 dark:text-red-400 shrink-0 mt-0.5"><HarveyBall level="quarter" size={14} /></span>
                    <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-50 font-semibold">{cm.scoring.scoreLabel1}:</strong> {detail.tier1}</span>
                  </li>
                </ul>
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <div class="technical-only space-y-4">
      <div class="fade-in-section rounded-2xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-6 md:p-8">
        <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 dark:text-indigo-300 mb-3">
          <Code2 size={16} />
          {t.common.technicalDetail}
        </p>
        <h3 id="credential-managers-tech-callout" class="text-xl font-bold text-indigo-900 dark:text-indigo-200 mb-3 scroll-mt-24">{cm.techCallout.headline}</h3>
        <RichText class="text-indigo-800 dark:text-indigo-300 leading-relaxed" text={cm.techCallout.body} />
        <TechCalloutLinks links={cm.techCallout.additionalLinks} t={t} />
      </div>
    </div>
  </div>

  {hasWhatsMissing && (
    <>
      <script type="application/json" id="whats-missing-data" set:html={JSON.stringify(whatsMissingMeta).replace(/</g, '\\u003c')} />
      <dialog
        id="whats-missing-dialog"
        class="whats-missing-dialog bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-50 border border-gray-200 dark:border-gray-700 shadow-2xl"
        aria-labelledby="whats-missing-title"
        closedby="any"
      >
        <div class="p-5 md:p-6">
          <div class="md:hidden mx-auto -mt-2 mb-3 h-1 w-10 rounded-full bg-gray-300 dark:bg-gray-600" aria-hidden="true"></div>
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-2">{cm.scoring.whatsMissingLabel}</p>
              <h4 id="whats-missing-title" class="flex items-center gap-2 text-lg font-bold leading-snug">
                {rankedManagers.map((m) => (
                  <span class="shrink-0" data-wm-icon={m.key} hidden><ManagerIcon managerKey={m.key} size={22} /></span>
                ))}
                <span data-wm-manager></span>
              </h4>
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1 text-sm text-gray-600 dark:text-gray-400">
                <span data-wm-criterion></span>
                <span class="inline-flex items-center gap-1 font-semibold">
                  <span class="inline-flex text-amber-600 dark:text-amber-400" data-wm-ball="3" hidden><HarveyBall level="half" size={14} /></span>
                  <span class="inline-flex text-red-600 dark:text-red-400" data-wm-ball="1" hidden><HarveyBall level="quarter" size={14} /></span>
                  <span data-wm-score></span>
                </span>
              </p>
            </div>
            <button
              type="button"
              class="shrink-0 -mr-2 -mt-2 inline-flex items-center justify-center w-11 h-11 rounded-full text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
              aria-label={cm.scoring.whatsMissingClose}
              data-wm-close
            >
              <X size={20} />
            </button>
          </div>
          <ul class="list-disc pl-5 space-y-2 text-gray-700 dark:text-gray-300 leading-relaxed marker:text-gray-400" data-wm-list></ul>
        </div>
      </dialog>
    </>
  )}
</section>

<script>
  {
    const dialog = document.getElementById('whats-missing-dialog') as HTMLDialogElement | null;
    const dataEl = document.getElementById('whats-missing-data');
    if (dialog && dataEl) {
      const data = JSON.parse(dataEl.textContent || '{}') as {
        managers: Record<string, string>;
        criteria: Record<string, string>;
        scores: Record<string, Record<string, number>>;
        scoreLabels: Record<string, string>;
        lists: Record<string, Record<string, string[]>>;
      };
      const html = document.documentElement;
      const managerEl = dialog.querySelector<HTMLElement>('[data-wm-manager]')!;
      const criterionEl = dialog.querySelector<HTMLElement>('[data-wm-criterion]')!;
      const scoreEl = dialog.querySelector<HTMLElement>('[data-wm-score]')!;
      const listEl = dialog.querySelector<HTMLUListElement>('[data-wm-list]')!;

      function open(manager: string, criterion: string) {
        const items = data.lists[manager]?.[criterion];
        if (!items) return;
        const score = String(data.scores[manager]?.[criterion]);
        dialog!.querySelectorAll<HTMLElement>('[data-wm-icon]').forEach((el) => (el.hidden = el.dataset.wmIcon !== manager));
        dialog!.querySelectorAll<HTMLElement>('[data-wm-ball]').forEach((el) => (el.hidden = el.dataset.wmBall !== score));
        managerEl.textContent = data.managers[manager];
        criterionEl.textContent = data.criteria[criterion];
        scoreEl.textContent = `${data.scoreLabels[score] ?? ''} · ${score}`;
        listEl.replaceChildren(
          ...items.map((text) => {
            const li = document.createElement('li');
            li.textContent = text;
            return li;
          })
        );
        dialog!.showModal();
      }

      document.addEventListener('click', (e) => {
        const trigger = (e.target as Element | null)?.closest<HTMLElement>('.whats-missing-trigger');
        if (trigger?.dataset.manager && trigger.dataset.criterion) {
          open(trigger.dataset.manager, trigger.dataset.criterion);
        }
      });

      dialog.querySelector('[data-wm-close]')?.addEventListener('click', () => dialog.close());

      // Backdrop click fallback for browsers without closedby="any": the
      // panel fills the dialog box, so a click whose target is the dialog
      // element itself landed on the ::backdrop.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      // Technical mode only: close if the reader switches back to consumer.
      new MutationObserver(() => {
        if (dialog.open && html.getAttribute('data-mode') !== 'technical') dialog.close();
      }).observe(html, { attributes: true, attributeFilter: ['data-mode'] });
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.criterion-jump').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.criterion;
      const target = id && document.getElementById(`criterion-${id}`);
      if (!(target instanceof HTMLDetailsElement)) return;
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
