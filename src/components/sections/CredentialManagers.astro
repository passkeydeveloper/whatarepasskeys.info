---
import { Code2, Check, Minus, X, ChevronDown } from 'lucide-astro';
import ManagerIcon from '../ManagerIcon.astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';
import { criteria, managerScores, type ScoreValue, type Grade } from '../../data/credentialManagers';

interface Props {
  t: any;
}
const { t } = Astro.props;
const cm = t.credentialManagers;

// Card styling for the intro grid. Add a row here for each new credential
// manager; the scoring table/cards below pull automatically from
// src/data/credentialManagers.ts.
const managers = [
  { key: 'apple',      bg: 'bg-gray-50',    border: 'border-gray-200' },
  { key: 'google',     bg: 'bg-blue-50',    border: 'border-blue-200' },
  { key: '1password',  bg: 'bg-blue-50',    border: 'border-blue-200' },
  { key: 'bitwarden',  bg: 'bg-indigo-50',  border: 'border-indigo-200' },
  { key: 'dashlane',   bg: 'bg-emerald-50', border: 'border-emerald-200' },
  { key: 'microsoft',  bg: 'bg-teal-50',    border: 'border-teal-200' },
  { key: 'nordpass',   bg: 'bg-teal-50',    border: 'border-teal-200' },
  { key: 'keeper',     bg: 'bg-red-50',     border: 'border-red-200' },
  { key: 'protonpass', bg: 'bg-purple-50',  border: 'border-purple-200' },
  { key: 'lastpass',   bg: 'bg-red-50',     border: 'border-red-200' },
] as const;

const alphabeticalManagers = [...managers].sort((a, b) =>
  (cm.managers as any)[a.key].name.localeCompare((cm.managers as any)[b.key].name)
);

const coreCriteria = criteria.filter((c) => c.weight === 'core');
const lowerCriteria = criteria.filter((c) => c.weight === 'lower');

function criterionLabel(id: string): { consumerLabel: string; technicalLabel: string } {
  return (cm.scoring.criteria as any)[id];
}

// Defensive re-sort: keeps the ranking correct even if a future entry is
// appended to managerScores out of order.
const rankedManagers = [...managerScores].sort((a, b) => b.weightedScore - a.weightedScore);

function gradeBadgeClass(grade: Grade) {
  switch (grade) {
    case 'A': return 'bg-emerald-600';
    case 'B': return 'bg-teal-500';
    case 'C': return 'bg-amber-500';
    case 'D': return 'bg-orange-500';
    default: return 'bg-red-600';
  }
}

function scoreMeta(value: ScoreValue) {
  if (value === 5) return { type: 'check' as const, color: 'text-emerald-600', bg: 'bg-emerald-50', label: cm.scoring.scoreLabel5 };
  if (value === 3) return { type: 'partial' as const, color: 'text-amber-600', bg: 'bg-amber-50', label: cm.scoring.scoreLabel3 };
  return { type: 'cross' as const, color: 'text-red-600', bg: 'bg-red-50', label: cm.scoring.scoreLabel1 };
}
---
<section id="credential-managers" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{cm.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {cm.headline}
      </h2>
      <RichText class="text-xl text-gray-600 leading-relaxed max-w-3xl mb-4" text={cm.intro} />
      <p class="text-lg text-gray-500 leading-relaxed max-w-3xl mb-4">{cm.platformNote}</p>
      <p class="text-lg text-gray-500 leading-relaxed max-w-3xl">{cm.convenienceNote}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
      {alphabeticalManagers.map((manager, i) => {
        const data = (cm.managers as any)[manager.key];
        return (
          <div
            class={`fade-in-section manager-card rounded-2xl border ${manager.border} ${manager.bg} p-5`}
            style={`transition-delay: ${i * 0.08}s`}
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="shrink-0">
                <ManagerIcon managerKey={manager.key} size={24} />
              </span>
              <h3 class="font-bold text-gray-900">{data.name}</h3>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed">{data.description}</p>
          </div>
        );
      })}
    </div>

    <!-- Scoring -->
    <div class="fade-in-section mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{cm.scoring.sectionLabel}</p>
      <h3 class="text-3xl md:text-4xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
        {cm.scoring.headline}
      </h3>
      <RichText class="text-lg text-gray-600 leading-relaxed max-w-3xl mb-3" text={cm.scoring.intro} />
      <p class="text-base text-gray-500 leading-relaxed max-w-3xl mb-8">{cm.scoring.methodologyIntro}</p>
    </div>

    <!-- Legend -->
    <div class="fade-in-section flex flex-wrap items-center gap-x-5 gap-y-2 mb-6 text-xs font-semibold text-gray-500">
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-50 text-emerald-600"><Check size={12} /></span>
        {cm.scoring.scoreLabel5}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-50 text-amber-600"><Minus size={12} /></span>
        {cm.scoring.scoreLabel3}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-50 text-red-600"><X size={12} /></span>
        {cm.scoring.scoreLabel1}
      </span>
    </div>

    <!-- Mobile: cards, one per credential manager -->
    <div class="md:hidden space-y-4 mb-4">
      {rankedManagers.map((m) => {
        const data = (cm.managers as any)[m.key];
        return (
          <div class="fade-in-section rounded-2xl border border-gray-200 bg-white p-5">
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2 min-w-0">
                <span class="shrink-0"><ManagerIcon managerKey={m.key} size={22} /></span>
                <span class="font-bold text-gray-900 truncate">{data.name}</span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class={`inline-flex items-center justify-center w-9 h-9 rounded-full text-white font-bold ${gradeBadgeClass(m.grade)}`}>
                  {m.grade}
                </span>
                <span class="consumer-only text-[11px] text-gray-400">{m.weightedScore}/100</span>
                <span class="technical-only text-xs text-gray-600 font-semibold">{m.weightedScore}/100</span>
              </div>
            </div>
            <div>
              {coreCriteria.map((c) => {
                const value = m.scores[c.id];
                const meta = scoreMeta(value);
                const label = criterionLabel(c.id);
                return (
                  <div class="flex items-center justify-between gap-3 py-1.5 text-sm border-b border-gray-100">
                    <button
                      type="button"
                      class="criterion-jump text-left underline decoration-dotted decoration-gray-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                      data-criterion={c.id}
                    >
                      <span class="consumer-only text-gray-600">{label.consumerLabel}</span>
                      <span class="technical-only text-gray-600">{label.technicalLabel}</span>
                    </button>
                    <span class={`inline-flex items-center gap-1 font-semibold shrink-0 ${meta.color}`}>
                      {meta.type === 'check' && <Check size={14} />}
                      {meta.type === 'partial' && <Minus size={14} />}
                      {meta.type === 'cross' && <X size={14} />}
                      <span class="technical-only">{value}</span>
                    </span>
                  </div>
                );
              })}
              {lowerCriteria.map((c, i) => {
                const value = m.scores[c.id];
                const meta = scoreMeta(value);
                const label = criterionLabel(c.id);
                return (
                  <div class={`flex items-center justify-between gap-3 py-1.5 text-sm border-b border-gray-100 last:border-0 ${i === 0 ? 'mt-1' : ''}`}>
                    <button
                      type="button"
                      class="criterion-jump text-left underline decoration-dotted decoration-gray-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                      data-criterion={c.id}
                    >
                      <span class="consumer-only text-gray-500">{label.consumerLabel}</span>
                      <span class="technical-only text-gray-500">{label.technicalLabel}</span>
                    </button>
                    <span class={`inline-flex items-center gap-1 font-semibold shrink-0 ${meta.color}`}>
                      {meta.type === 'check' && <Check size={14} />}
                      {meta.type === 'partial' && <Minus size={14} />}
                      {meta.type === 'cross' && <X size={14} />}
                      <span class="technical-only">{value}</span>
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Desktop: table, one row per credential manager -->
    <div class="hidden md:block fade-in-section overflow-x-auto mb-4">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th rowspan={2} class="text-left py-3 px-4 text-sm text-gray-500 font-semibold border-b border-gray-200 align-bottom"></th>
            <th rowspan={2} class="text-center py-3 px-3 text-sm text-gray-500 font-semibold border-b border-gray-200 align-bottom">
              {cm.scoring.gradeLabel}
            </th>
            <th colspan={coreCriteria.length} class="text-center py-2 px-3 text-[11px] uppercase tracking-wider text-gray-400 font-semibold border-b border-gray-100">
              {cm.scoring.coreGroupLabel}
            </th>
            <th colspan={lowerCriteria.length} class="text-center py-2 px-3 text-[11px] uppercase tracking-wider text-gray-400 font-semibold border-b border-gray-100 border-l-2 border-l-gray-200">
              {cm.scoring.lowerGroupLabel}
            </th>
          </tr>
          <tr>
            {coreCriteria.map((c) => (
              <th class="text-center py-2 px-3 text-xs font-bold text-gray-700 border-b border-gray-200 max-w-[7rem]">
                <button
                  type="button"
                  class="criterion-jump inline underline decoration-dotted decoration-gray-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                  data-criterion={c.id}
                >
                  <span class="consumer-only">{criterionLabel(c.id).consumerLabel}</span>
                  <span class="technical-only">{criterionLabel(c.id).technicalLabel}</span>
                </button>
              </th>
            ))}
            {lowerCriteria.map((c, i) => (
              <th class={`text-center py-2 px-3 text-xs font-bold text-gray-700 border-b border-gray-200 max-w-[7rem] ${i === 0 ? 'border-l-2 border-l-gray-200' : ''}`}>
                <button
                  type="button"
                  class="criterion-jump inline underline decoration-dotted decoration-gray-300 underline-offset-2 hover:text-indigo-600 hover:decoration-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded"
                  data-criterion={c.id}
                >
                  <span class="consumer-only">{criterionLabel(c.id).consumerLabel}</span>
                  <span class="technical-only">{criterionLabel(c.id).technicalLabel}</span>
                </button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rankedManagers.map((m, ri) => {
            const data = (cm.managers as any)[m.key];
            return (
              <tr class={ri % 2 === 0 ? 'bg-gray-50/50' : 'bg-white'}>
                <td class="py-3 px-4 border-b border-gray-100">
                  <div class="flex items-center gap-2">
                    <span class="shrink-0"><ManagerIcon managerKey={m.key} size={20} /></span>
                    <span class="font-semibold text-gray-900 text-sm whitespace-nowrap">{data.name}</span>
                  </div>
                </td>
                <td class="py-3 px-3 text-center border-b border-gray-100">
                  <span class="inline-flex flex-col items-center gap-0.5">
                    <span class={`inline-flex items-center justify-center w-8 h-8 rounded-full text-white font-bold text-sm ${gradeBadgeClass(m.grade)}`}>
                      {m.grade}
                    </span>
                    <span class="consumer-only text-[10px] text-gray-400">{m.weightedScore}/100</span>
                    <span class="technical-only text-xs text-gray-600 font-semibold">{m.weightedScore}/100</span>
                  </span>
                </td>
                {coreCriteria.map((c) => {
                  const value = m.scores[c.id];
                  const meta = scoreMeta(value);
                  return (
                    <td class="py-3 px-3 text-center border-b border-gray-100">
                      <span class="inline-flex flex-col items-center gap-0.5">
                        <span class={`inline-flex items-center justify-center w-6 h-6 rounded-full ${meta.bg} ${meta.color}`}>
                          {meta.type === 'check' && <Check size={14} />}
                          {meta.type === 'partial' && <Minus size={14} />}
                          {meta.type === 'cross' && <X size={14} />}
                        </span>
                        <span class="technical-only text-[10px] text-gray-400">{value}</span>
                      </span>
                    </td>
                  );
                })}
                {lowerCriteria.map((c, i) => {
                  const value = m.scores[c.id];
                  const meta = scoreMeta(value);
                  return (
                    <td class={`py-3 px-3 text-center border-b border-gray-100 ${i === 0 ? 'border-l-2 border-l-gray-200' : ''}`}>
                      <span class="inline-flex flex-col items-center gap-0.5">
                        <span class={`inline-flex items-center justify-center w-6 h-6 rounded-full ${meta.bg} ${meta.color}`}>
                          {meta.type === 'check' && <Check size={14} />}
                          {meta.type === 'partial' && <Minus size={14} />}
                          {meta.type === 'cross' && <X size={14} />}
                        </span>
                        <span class="technical-only text-[10px] text-gray-400">{value}</span>
                      </span>
                    </td>
                  );
                })}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="fade-in-section text-sm text-gray-500 italic text-right mb-12">{cm.scoring.lastUpdated}</p>

    <!-- Criteria details -->
    <div class="fade-in-section mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{cm.scoring.criteriaDetails.sectionLabel}</p>
      <h3 class="text-2xl md:text-3xl font-extrabold leading-tight tracking-tight text-gray-900 mb-3">
        {cm.scoring.criteriaDetails.headline}
      </h3>
      <RichText class="text-base text-gray-500 leading-relaxed max-w-3xl" text={cm.scoring.criteriaDetails.intro} />
    </div>

    <div class="space-y-0 divide-y divide-gray-100 mb-16">
      {criteria.map((c, i) => {
        const detail = (cm.scoring.criteriaDetails.items as any)[c.id];
        const label = criterionLabel(c.id);
        return (
          <details id={`criterion-${c.id}`} class="faq-item fade-in-section scroll-mt-24" style={`transition-delay: ${i * 0.05}s`}>
            <summary>
              <span class="flex items-center gap-2 flex-wrap">
                <span class="consumer-only">{label.consumerLabel}</span>
                <span class="technical-only">{label.technicalLabel}</span>
                <span class={`technical-only text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full ${c.weight === 'core' ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-500'}`}>
                  {c.weight === 'core' ? cm.scoring.coreTag : cm.scoring.lowerTag}
                </span>
              </span>
              <ChevronDown size={20} class="faq-chevron" />
            </summary>
            <div class="pb-5">
              <p class="consumer-only text-gray-600 leading-relaxed">{detail.consumerBody}</p>
              <div class="technical-only">
                <p class="text-gray-600 leading-relaxed mb-4">{detail.technicalBody}</p>
                <ul class="space-y-2 text-sm">
                  <li class="flex items-start gap-2">
                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 shrink-0 mt-0.5"><Check size={12} /></span>
                    <span class="text-gray-600"><strong class="text-gray-900 font-semibold">{cm.scoring.scoreLabel5}:</strong> {detail.tier5}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-50 text-amber-600 shrink-0 mt-0.5"><Minus size={12} /></span>
                    <span class="text-gray-600"><strong class="text-gray-900 font-semibold">{cm.scoring.scoreLabel3}:</strong> {detail.tier3}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-50 text-red-600 shrink-0 mt-0.5"><X size={12} /></span>
                    <span class="text-gray-600"><strong class="text-gray-900 font-semibold">{cm.scoring.scoreLabel1}:</strong> {detail.tier1}</span>
                  </li>
                </ul>
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <div class="technical-only space-y-4">
      <div class="fade-in-section rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
        <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
          <Code2 size={16} />
          Technical detail
        </p>
        <h3 class="text-xl font-bold text-indigo-900 mb-3">{cm.techCallout.headline}</h3>
        <RichText class="text-indigo-800 leading-relaxed" text={cm.techCallout.body} />
        <TechCalloutLinks links={cm.techCallout.additionalLinks} />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.criterion-jump').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.criterion;
      const target = id && document.getElementById(`criterion-${id}`);
      if (!(target instanceof HTMLDetailsElement)) return;
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
