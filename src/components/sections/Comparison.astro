---
import { Check, X, Trophy, Code2 } from 'lucide-astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const c = t.whyPasskeysWin;

const methods = ['password', 'passwordSms', 'magicLink', 'passkey'] as const;
const categories = ['passwordRequired', 'phishable', 'stolenFromServer', 'replayAttack', 'easiness'] as const;

type CellResult =
  | { type: 'check'; bold: boolean }
  | { type: 'cross'; bold: boolean }
  | { type: 'text' };

function cellResult(value: string, method: string): CellResult {
  if (value === 'No') return { type: 'check', bold: method === 'passkey' };
  if (value === 'Yes') return { type: 'cross', bold: method === 'passkey' };
  return { type: 'text' };
}
---
<section id="comparison" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-linear-to-br from-emerald-50 to-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{c.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-4">
        {c.headline}
      </h2>
      <p class="text-xl text-gray-600 leading-relaxed">{c.tagline}</p>
    </div>

    <!-- Mobile: cards -->
    <div class="md:hidden space-y-4 mb-8">
      {methods.map(method => {
        const m = (c.methods as any)[method];
        const isPasskey = method === 'passkey';
        return (
          <div class={`rounded-2xl border p-5 ${isPasskey ? 'border-indigo-300 bg-linear-to-br from-indigo-50 to-emerald-50 shadow-md' : 'border-gray-100 bg-white'}`}>
            <h3 class={`flex items-center gap-2 text-lg font-bold mb-3 ${isPasskey ? 'text-indigo-700' : 'text-gray-900'}`}>
              {isPasskey && <Trophy size={16} />}
              {m.name}
            </h3>
            {categories.map(cat => {
              const val = m[cat];
              const result = cellResult(val, method);
              return (
                <div class="flex justify-between items-center py-1.5 text-sm border-b border-gray-100 last:border-0">
                  <span class="text-gray-500">{(c.categories as any)[cat]}</span>
                  <span class={`flex items-center gap-1 ${result.type === 'check' ? 'text-emerald-700' : result.type === 'cross' ? 'text-red-600' : 'text-gray-500'} ${result.type !== 'text' && result.bold ? 'font-bold' : ''}`}>
                    {result.type === 'check' && <Check size={14} />}
                    {result.type === 'cross' && <X size={14} />}
                    {val}
                  </span>
                </div>
              );
            })}
          </div>
        );
      })}
    </div>

    <!-- Desktop: table -->
    <div class="hidden md:block fade-in-section overflow-x-auto mb-8">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="text-left py-3 px-4 text-sm text-gray-500 font-semibold border-b border-gray-200 w-1/4"></th>
            {methods.map(method => {
              const m = (c.methods as any)[method];
              const isPasskey = method === 'passkey';
              return (
                <th class={`text-center py-3 px-4 text-sm font-bold border-b ${isPasskey ? 'text-indigo-700 comparison-passkey-col rounded-t-xl border-indigo-200' : 'text-gray-700 border-gray-200'}`}>
                  <span class="inline-flex items-center justify-center gap-1.5">
                    {isPasskey && <Trophy size={14} />}
                    {m.name}
                  </span>
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          {categories.map((cat, ri) => (
            <tr class={ri % 2 === 0 ? 'bg-gray-50/50' : 'bg-white'}>
              <td class="py-3 px-4 text-sm text-gray-600 font-medium border-b border-gray-100">
                {(c.categories as any)[cat]}
              </td>
              {methods.map(method => {
                const val = (c.methods as any)[method][cat];
                const result = cellResult(val, method);
                const isPasskey = method === 'passkey';
                return (
                  <td class={`py-3 px-4 text-center text-sm border-b border-gray-100 ${isPasskey ? 'comparison-passkey-col border-indigo-100' : ''}`}>
                    <span class={`inline-flex items-center justify-center gap-1 ${result.type === 'check' ? 'text-emerald-700' : result.type === 'cross' ? 'text-red-600' : 'text-gray-500'} ${result.type !== 'text' && result.bold ? 'font-bold' : ''}`}>
                      {result.type === 'check' && <Check size={14} />}
                      {result.type === 'cross' && <X size={14} />}
                      {val}
                    </span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="technical-only fade-in-section rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
        <Code2 size={16} />
        Technical detail
      </p>
      <h3 class="text-xl font-bold text-indigo-900 mb-3">{c.techCallout.headline}</h3>
      <p class="text-indigo-800 leading-relaxed">{c.techCallout.body}</p>
    </div>
  </div>
</section>
