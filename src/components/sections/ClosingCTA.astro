---
import { KeyRound, LogIn } from 'lucide-astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const cta = t.closingCTA;
---
<section id="say-goodbye" class="min-h-screen flex flex-col justify-center items-center py-24 px-6 bg-linear-to-br from-indigo-600 via-indigo-700 to-emerald-700 text-white text-center relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-white rounded-full blur-3xl opacity-5"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-emerald-300 rounded-full blur-3xl opacity-10"></div>
  </div>

  <div class="max-w-3xl mx-auto w-full relative z-10">
    <div class="fade-in-section">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-200 mb-4">{cta.sectionLabel}</p>
      <h2 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
        {cta.headline}
      </h2>
      <p class="text-xl md:text-2xl text-indigo-100 leading-relaxed mb-4">{cta.body}</p>
      <p class="text-lg text-indigo-200 leading-relaxed mb-10 max-w-2xl mx-auto">{cta.detail}</p>
    </div>

    <div class="fade-in-section flex flex-col sm:flex-row items-center justify-center gap-4 mb-10" style="transition-delay: 0.15s">
      <span class="inline-flex items-center gap-2 bg-white text-indigo-700 font-bold rounded-2xl px-6 py-3 text-base">
        <KeyRound size={18} />
        {cta.createLabel}
      </span>
      <span class="inline-flex items-center gap-2 bg-white/10 border border-white/30 text-white font-bold rounded-2xl px-6 py-3 text-base">
        <LogIn size={18} />
        {cta.signInLabel}
      </span>
    </div>

    <a
      href="#faq"
      class="fade-in-section inline-flex items-center gap-2 text-indigo-100 hover:text-white underline underline-offset-4 font-semibold"
      style="transition-delay: 0.3s"
    >
      {cta.cta}
    </a>
  </div>
</section>
