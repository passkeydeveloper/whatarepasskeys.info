---
import { Lock, MonitorSmartphone } from 'lucide-astro';
import RichText from '../RichText.astro';

interface Props {
    t: any;
}
const { t } = Astro.props;
const cta = t.closingCTA;
---

<section
    id="say-goodbye"
    class="min-h-screen flex flex-col justify-center items-center py-24 px-6 bg-linear-to-br from-indigo-600 via-indigo-700 to-emerald-700 text-white text-center relative overflow-hidden"
>
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-white rounded-full blur-3xl opacity-5"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-emerald-300 rounded-full blur-3xl opacity-10"></div>
    </div>

    <div class="max-w-3xl mx-auto w-full relative z-10">
        <div class="fade-in-section">
            <p class="text-sm font-semibold uppercase tracking-widest text-indigo-50 mb-4">
                {cta.sectionLabel}
            </p>
            <h2 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
                {cta.headline}
            </h2>
            <p class="text-xl md:text-2xl text-indigo-50 leading-relaxed mb-10">
                {cta.body} {cta.iconCalloutBody}
            </p>
        </div>

        <div class="fade-in-section mb-10" style="transition-delay: 0.15s">
            <div class="inline-flex flex-wrap items-center justify-center gap-8 bg-white rounded-3xl px-8 py-6 md:px-10 md:py-8 shadow-lg">
                <img
                    src="/images/passkey-icons/passkey-icon-2024-black-nobox.svg"
                    alt={cta.passkeyIconAlt}
                    class="w-16 h-16 md:w-20 md:h-20"
                    width="80"
                    height="80"
                />
                <img
                    src="/images/passkey-yellow-box.svg"
                    alt={cta.passkeyIconAlt}
                    class="w-16 h-16 md:w-20 md:h-20"
                    width="80"
                    height="80"
                />
                <img
                    src="/images/passkey-icons/apple-passkey.svg"
                    alt={cta.applePasskeyIconAlt}
                    class="w-16 h-16 md:w-20 md:h-20"
                    width="80"
                    height="80"
                />
                <img
                    src="/images/passkey-icons/google-passkey.svg"
                    alt={cta.googlePasskeyIconAlt}
                    class="w-16 h-16 md:w-20 md:h-20"
                    width="80"
                    height="80"
                />
            </div>
        </div>

        <div
            class="fade-in-section flex flex-col items-center gap-8 mb-10"
            style="transition-delay: 0.3s"
        >
            <p class="text-xl md:text-2xl font-semibold uppercase tracking-widest text-indigo-50">{cta.examplesLabel}</p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
            <div class="flex flex-col items-center gap-3">
                <span class="inline-flex items-center gap-2 bg-white text-indigo-700 font-bold rounded-2xl px-6 py-3 text-base">
                    <img
                        src="/images/passkey-icons/passkey-icon-2024-black-nobox.svg"
                        alt=""
                        aria-hidden="true"
                        class="w-5 h-5"
                        width="20"
                        height="20"
                    />
                    {cta.createLabel}
                </span>
                <p class="text-sm font-semibold text-indigo-50">{cta.createButtonCaption}</p>
            </div>
            <div class="flex flex-col items-center gap-3">
                <span class="inline-flex items-center gap-2 bg-white/10 border border-white/30 text-white font-bold rounded-2xl px-6 py-3 text-base">
                    <img
                        src="/images/passkey-icons/passkey-icon-2024-white-nobox.svg"
                        alt=""
                        aria-hidden="true"
                        class="w-5 h-5"
                        width="20"
                        height="20"
                    />
                    {cta.signInLabel}
                </span>
                <p class="text-sm font-semibold text-indigo-50">{cta.signInButtonCaption}</p>
            </div>
            </div>
        </div>

        <div
            class="fade-in-section flex flex-col sm:flex-row items-stretch justify-center gap-10 mb-12 max-w-3xl mx-auto"
            style="transition-delay: 0.35s"
        >
            <div class="flex flex-col items-center gap-3">
                <div class="w-96 flex-1 rounded-2xl bg-white shadow-xl overflow-hidden text-left" aria-hidden="true">
                    <div class="flex items-center gap-1.5 px-3 py-2 bg-gray-100 border-b border-gray-200">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
                        <span class="ml-3 flex-1 text-center text-xs text-gray-500 bg-white border border-gray-200 rounded-full px-3 py-0.5 truncate">
                            example.com
                        </span>
                    </div>
                    <div class="p-4 pb-36 relative">
                        <label class="block text-xs font-semibold text-gray-500 mb-1">{cta.usernameLabel}</label>
                        <div class="w-full rounded-lg border-2 border-indigo-400 px-3 py-2 text-sm text-gray-400">
                            {cta.usernameLabel}
                        </div>
                        <div class="absolute left-4 right-4 top-[4.5rem] rounded-xl border border-gray-200 shadow-lg bg-white overflow-hidden z-10">
                            <div class="flex items-center gap-3 px-3 py-3">
                                <img
                                    src="/images/passkey-icons/passkey-icon-2024-black-nobox.svg"
                                    alt={cta.passkeyIconAlt}
                                    class="w-6 h-6 shrink-0"
                                    width="24"
                                    height="24"
                                />
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 truncate">m3@whatarepasskeys.info</p>
                                    <p class="text-xs text-gray-500">{cta.passkeyLabel}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 px-3 py-2.5 border-t border-gray-100 text-gray-600">
                                <MonitorSmartphone size={16} class="shrink-0" />
                                <p class="text-xs font-medium">{cta.useAnotherDevice}</p>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-sm font-semibold text-indigo-50">{cta.autofillCaption}</p>
            </div>

            <div class="flex flex-col items-center gap-3">
                <div class="w-[220px] flex-1 rounded-[2rem] border-4 border-gray-800 bg-gray-800 shadow-xl overflow-hidden flex flex-col" aria-hidden="true">
                    <div class="bg-white overflow-hidden flex-1 flex flex-col">
                        <div class="flex items-center justify-center gap-1 px-3 py-1.5 bg-gray-100 border-b border-gray-200">
                            <Lock size={10} class="text-emerald-600" />
                            <span class="text-[10px] text-gray-500 truncate">example.com</span>
                        </div>
                        <div class="px-3 py-3 space-y-2 text-left">
                            <p class="text-[9px] font-semibold text-gray-500">{cta.usernameLabel}</p>
                            <div class="h-6 rounded-md border-2 border-indigo-400 px-2 flex items-center">
                                <p class="text-[9px] text-gray-400">{cta.usernameLabel}</p>
                            </div>
                        </div>
                        <div class="mt-auto flex items-center gap-2 px-3 py-2 bg-gray-50 border-y border-gray-200 text-left">
                            <img
                                src="/images/passkey-icons/passkey-icon-2024-black-nobox.svg"
                                alt={cta.passkeyIconAlt}
                                class="w-4 h-4 shrink-0"
                                width="16"
                                height="16"
                            />
                            <div class="min-w-0">
                                <p class="text-[10px] font-semibold text-gray-900 truncate">m3@whatarepasskeys.info</p>
                                <p class="text-[9px] text-gray-500">{cta.forDomain.replace('{domain}', 'example.com')}</p>
                            </div>
                        </div>
                        <div class="bg-gray-200 px-2 py-2 space-y-1">
                            <div class="grid grid-cols-10 gap-1">
                                {Array.from({ length: 10 }).map(() => (
                                    <div class="h-4 rounded-xs bg-white"></div>
                                ))}
                            </div>
                            <div class="grid grid-cols-9 gap-1 px-2">
                                {Array.from({ length: 9 }).map(() => (
                                    <div class="h-4 rounded-xs bg-white"></div>
                                ))}
                            </div>
                            <div class="grid grid-cols-7 gap-1 px-4">
                                {Array.from({ length: 7 }).map(() => (
                                    <div class="h-4 rounded-xs bg-white"></div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-sm font-semibold text-indigo-50">{cta.keyboardCaption}</p>
            </div>
        </div>

        <div class="fade-in-section" style="transition-delay: 0.4s">
            <RichText class="text-lg text-white font-medium leading-relaxed max-w-2xl mx-auto" text={cta.detail} />
        </div>
    </div>
</section>
