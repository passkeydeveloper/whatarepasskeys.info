---
interface Props {
    t: any;
}
const { t } = Astro.props;
const cta = t.closingCTA;
---

<section
    id="say-goodbye"
    class="min-h-screen flex flex-col justify-center items-center py-24 px-6 bg-linear-to-br from-indigo-600 via-indigo-700 to-emerald-700 text-white text-center relative overflow-hidden"
>
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-white rounded-full blur-3xl opacity-5"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-emerald-300 rounded-full blur-3xl opacity-10"></div>
    </div>

    <div class="max-w-3xl mx-auto w-full relative z-10">
        <div class="fade-in-section">
            <p class="text-sm font-semibold uppercase tracking-widest text-indigo-50 mb-4">
                {cta.sectionLabel}
            </p>
            <h2 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6">
                {cta.headline}
            </h2>
            <p class="text-xl md:text-2xl text-indigo-50 leading-relaxed mb-10">
                {cta.body}
            </p>
        </div>

        <div class="fade-in-section mb-10" style="transition-delay: 0.15s">
            <p class="text-xl md:text-2xl font-bold text-white leading-relaxed mb-6 max-w-2xl mx-auto">
                {cta.iconCalloutBody}
            </p>
            <div class="inline-flex flex-wrap items-center justify-center gap-8 bg-white rounded-3xl px-8 py-6 md:px-10 md:py-8 shadow-lg">
                <img
                    src="/images/passkey-icons/passkey-icon-2024-black-nobox.svg"
                    alt="Passkey icon"
                    class="w-16 h-16 md:w-20 md:h-20"
                />
                <img
                    src="/images/passkey-yellow-box.svg"
                    alt="Passkey icon"
                    class="w-16 h-16 md:w-20 md:h-20"
                />
                <img
                    src="/images/passkey-icons/apple-passkey.svg"
                    alt="Apple passkey icon"
                    class="w-16 h-16 md:w-20 md:h-20"
                />
                <img
                    src="/images/passkey-icons/google-passkey.svg"
                    alt="Google passkey icon"
                    class="w-16 h-16 md:w-20 md:h-20"
                />
            </div>
        </div>

        <div
            class="fade-in-section flex flex-col sm:flex-row items-center justify-center gap-4 mb-10"
            style="transition-delay: 0.3s"
        >
            <span class="inline-flex items-center gap-2 bg-white text-indigo-700 font-bold rounded-2xl px-6 py-3 text-base">
                <img
                    src="/images/passkey-icons/passkey-icon-2024-black-nobox.svg"
                    alt=""
                    aria-hidden="true"
                    class="w-5 h-5"
                />
                {cta.createLabel}
            </span>
            <span class="inline-flex items-center gap-2 bg-white/10 border border-white/30 text-white font-bold rounded-2xl px-6 py-3 text-base">
                <img
                    src="/images/passkey-icons/passkey-icon-2024-white-nobox.svg"
                    alt=""
                    aria-hidden="true"
                    class="w-5 h-5"
                />
                {cta.signInLabel}
            </span>
        </div>

        <div class="fade-in-section" style="transition-delay: 0.4s">
            <p class="text-lg text-indigo-50 leading-relaxed max-w-2xl mx-auto">
                {cta.detail}
            </p>
        </div>
    </div>
</section>
