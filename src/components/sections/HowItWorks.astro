---
import { KeyRound, ScanFace, ShieldCheck, Sparkles, Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';
import { camelToKebab } from '../../utils/slug';

interface Props {
  t: any;
}
const { t } = Astro.props;
const h = t.howItWorks;

const steps = [
  { key: 'create',   Icon: KeyRound   },
  { key: 'confirm',  Icon: ScanFace   },
] as const;
const signedIn = { key: 'signedIn', Icon: ShieldCheck } as const;
---
<section id="how-it-works" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white dark:bg-gray-900">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400 mb-4">{h.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-50 mb-4">
        {h.headline}
      </h2>
      <RichText class="text-xl text-gray-600 dark:text-gray-400 leading-relaxed" text={h.intro} />
    </div>

    <div class="relative">
      <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-indigo-200 dark:from-indigo-800 via-emerald-200 dark:via-emerald-800 to-emerald-400 dark:to-emerald-600 -translate-x-1/2 hidden md:block" aria-hidden="true"></div>

      <div class="space-y-8">
        {steps.map((step, i) => (
          <div
            id={`hiw-row-${i}`}
            class={`flow-step relative flex gap-6 md:gap-0 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}
            data-delay={String(i * 150)}
          >
            <div id={`hiw-icon-${i}`} class="shrink-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:top-1/2 md:-translate-y-1/2 z-10">
              <div class="w-12 h-12 rounded-full flex items-center justify-center shadow-md bg-white dark:bg-gray-800 border-2 border-indigo-200 dark:border-indigo-800 text-indigo-600 dark:text-indigo-400">
                <step.Icon size={20} />
              </div>
            </div>

            <div class={`md:w-5/12 ${i % 2 === 0 ? 'md:pr-16' : 'md:pl-16 md:ml-auto'}`}>
              <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm p-5 hover:shadow-md transition-shadow">
                <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">{t.common.step.replace('{number}', String(i + 1))}</span>
                <h3 id={`how-it-works-${camelToKebab(step.key)}`} class="text-lg font-bold text-gray-900 dark:text-gray-50 mt-1 mb-1 scroll-mt-24">
                  {(h.steps as any)[step.key].label}
                </h3>
                <RichText class="text-gray-600 dark:text-gray-400" text={(h.steps as any)[step.key].body} />
              </div>
            </div>
          </div>
        ))}

        <div
          class="flow-step relative flex flex-col items-center text-center gap-4"
          data-delay={String(steps.length * 150)}
        >
          <div id="hiw-icon-end" class="w-12 h-12 rounded-full flex items-center justify-center shadow-md bg-emerald-600 text-white z-10">
            <signedIn.Icon size={20} />
          </div>
          <div class="max-w-md bg-emerald-50 dark:bg-emerald-950 border-2 border-emerald-200 dark:border-emerald-800 rounded-2xl shadow-sm p-5">
            <h3 id={`how-it-works-${camelToKebab(signedIn.key)}`} class="text-lg font-bold text-emerald-900 dark:text-emerald-200 mb-1 scroll-mt-24">
              {(h.steps as any)[signedIn.key].label}
            </h3>
            <RichText class="text-emerald-800 dark:text-emerald-300" text={(h.steps as any)[signedIn.key].body} />
          </div>
        </div>
      </div>
    </div>

    <div class="fade-in-section mt-12 rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 p-6 md:p-8 flex gap-4 items-start">
      <div class="shrink-0 w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white">
        <Sparkles size={20} />
      </div>
      <div>
        <h3 id="how-it-works-uniqueness" class="text-xl font-bold text-emerald-900 dark:text-emerald-200 mb-2 scroll-mt-24">{h.uniqueness.headline}</h3>
        <RichText class="text-emerald-800 dark:text-emerald-300 leading-relaxed" text={h.uniqueness.body} />
      </div>
    </div>

    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 dark:text-indigo-300 mb-3">
        <Code2 size={16} />
        {t.common.technicalDetail}
      </p>
      <h3 id="how-it-works-tech-callout" class="text-xl font-bold text-indigo-900 dark:text-indigo-200 mb-3 scroll-mt-24">{h.techCallout.headline}</h3>
      <RichText class="text-indigo-800 dark:text-indigo-300 leading-relaxed" text={h.techCallout.body} />
      <TechCalloutLinks links={h.techCallout.additionalLinks} t={t} />
    </div>
  </div>
</section>

<script>
  // Step 2's marker+card doesn't naturally land halfway between step 1's
  // and the "signed in" marker, since its vertical position is centered on
  // its own card and every card's height depends on its (translated) body
  // copy length. Shift the whole step-2 row (marker and card together, so
  // they stay paired) to that midpoint explicitly instead.
  function alignMiddleTimelineRow() {
    const first = document.getElementById('hiw-icon-0');
    const middleIcon = document.getElementById('hiw-icon-1');
    const middleRow = document.getElementById('hiw-row-1');
    const last = document.getElementById('hiw-icon-end');
    if (!first || !middleIcon || !middleRow || !last) return;

    const desktop = window.matchMedia('(min-width: 768px)');

    function centerY(el: HTMLElement) {
      const rect = el.getBoundingClientRect();
      return rect.top + rect.height / 2;
    }

    function reposition() {
      // Reset first so the measurement below reflects the natural,
      // CSS-centered-on-its-own-card position rather than a prior shift.
      middleRow!.style.top = '';
      if (!desktop.matches) return;
      const midpoint = (centerY(first!) + centerY(last!)) / 2;
      const natural = centerY(middleIcon!);
      middleRow!.style.top = `${midpoint - natural}px`;
    }

    reposition();
    window.addEventListener('resize', reposition);
    desktop.addEventListener('change', reposition);
    document.fonts?.ready?.then(reposition);
    // The scroll-reveal transition (opacity/translateY) briefly shifts these
    // elements; settle into the final position once it finishes.
    document.querySelectorAll('.flow-step').forEach((el) => {
      el.addEventListener('transitionend', reposition);
    });
    setTimeout(reposition, 700);
  }

  alignMiddleTimelineRow();
</script>
