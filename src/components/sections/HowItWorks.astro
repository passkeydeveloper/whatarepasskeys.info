---
import { KeyRound, ScanFace, ShieldCheck, Sparkles, Code2 } from 'lucide-astro';
import TechCalloutLinks from '../TechCalloutLinks.astro';
import RichText from '../RichText.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
const h = t.howItWorks;

const steps = [
  { key: 'create',   Icon: KeyRound   },
  { key: 'confirm',  Icon: ScanFace   },
] as const;
const signedIn = { key: 'signedIn', Icon: ShieldCheck } as const;
---
<section id="how-it-works" class="min-h-screen flex flex-col justify-center py-24 px-6 bg-white">
  <div class="max-w-5xl mx-auto w-full">
    <div class="fade-in-section mb-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-4">{h.sectionLabel}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-4">
        {h.headline}
      </h2>
      <RichText class="text-xl text-gray-600 leading-relaxed" text={h.intro} />
    </div>

    <div class="relative">
      <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-indigo-200 via-emerald-200 to-emerald-400 -translate-x-1/2 hidden md:block" aria-hidden="true"></div>

      <div class="space-y-8">
        {steps.map((step, i) => (
          <div
            class={`flow-step relative flex gap-6 md:gap-0 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}
            data-delay={String(i * 150)}
          >
            <div class="shrink-0 md:absolute md:left-1/2 md:-translate-x-1/2 md:top-1/2 md:-translate-y-1/2 z-10">
              <div class="w-12 h-12 rounded-full flex items-center justify-center shadow-md bg-white border-2 border-indigo-200 text-indigo-600">
                <step.Icon size={20} />
              </div>
            </div>

            <div class={`md:w-5/12 ${i % 2 === 0 ? 'md:pr-16' : 'md:pl-16 md:ml-auto'}`}>
              <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-shadow">
                <span class="text-xs font-bold uppercase tracking-widest text-indigo-600">Step {i + 1}</span>
                <h3 class="text-lg font-bold text-gray-900 mt-1 mb-1">
                  {(h.steps as any)[step.key].label}
                </h3>
                <RichText class="text-gray-600" text={(h.steps as any)[step.key].body} />
              </div>
            </div>
          </div>
        ))}

        <div
          class="flow-step relative flex flex-col items-center text-center gap-4"
          data-delay={String(steps.length * 150)}
        >
          <div class="w-12 h-12 rounded-full flex items-center justify-center shadow-md bg-emerald-600 text-white z-10">
            <signedIn.Icon size={20} />
          </div>
          <div class="max-w-md bg-emerald-50 border-2 border-emerald-200 rounded-2xl shadow-sm p-5">
            <h3 class="text-lg font-bold text-emerald-900 mb-1">
              {(h.steps as any)[signedIn.key].label}
            </h3>
            <RichText class="text-emerald-800" text={(h.steps as any)[signedIn.key].body} />
          </div>
        </div>
      </div>
    </div>

    <div class="fade-in-section mt-12 rounded-2xl border border-emerald-200 bg-emerald-50 p-6 md:p-8 flex gap-4 items-start">
      <div class="shrink-0 w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white">
        <Sparkles size={20} />
      </div>
      <div>
        <h3 class="text-xl font-bold text-emerald-900 mb-2">{h.uniqueness.headline}</h3>
        <RichText class="text-emerald-800 leading-relaxed" text={h.uniqueness.body} />
      </div>
    </div>

    <div class="technical-only fade-in-section mt-8 rounded-2xl border border-indigo-200 bg-indigo-50 p-6 md:p-8">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-indigo-700 mb-3">
        <Code2 size={16} />
        Technical detail
      </p>
      <h3 class="text-xl font-bold text-indigo-900 mb-3">{h.techCallout.headline}</h3>
      <RichText class="text-indigo-800 leading-relaxed" text={h.techCallout.body} />
      <TechCalloutLinks links={h.techCallout.additionalLinks} />
    </div>
  </div>
</section>
