---
interface Props {
  level: 'full' | 'half' | 'quarter';
  size?: number;
}

const { level, size = 16 } = Astro.props;
---
<svg viewBox="0 0 20 20" width={size} height={size} aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <circle cx="10" cy="10" r="8" fill={level === 'full' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" />
  {level === 'half' && <path d="M10 10 L10 2 A8 8 0 0 1 10 18 Z" fill="currentColor" />}
  {level === 'quarter' && <path d="M10 10 L10 2 A8 8 0 0 1 18 10 Z" fill="currentColor" />}
</svg>
