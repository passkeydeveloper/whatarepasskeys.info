---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import SectionDots from '../components/layout/SectionDots.astro';
import Footer from '../components/layout/Footer.astro';
import { useTranslations, locales, localeHref, bcp47Language } from '../i18n/utils';
import { stripRichTextLinks } from '../i18n/richText';
import { managerScores } from '../data/credentialManagers';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
// Open Graph requires language_TERRITORY locale codes (e.g. en_US), not the
// bare BCP-47-ish codes used for routing/i18n.
const ogTerritoryMap: Record<string, string> = {
  en: 'US',
  de: 'DE',
  es: 'ES',
  fr: 'FR',
  ja: 'JP',
};
const ogLocale = `${bcp47Language(locale)}_${ogTerritoryMap[locale] ?? bcp47Language(locale).toUpperCase()}`;
const ogImage = new URL('/og-image.png', Astro.site).toString();

// hreflang alternates so search engines route users to the right locale
// version directly, instead of relying on a client-side redirect.
const hreflangLinks = locales.map((code) => ({
  hreflang: bcp47Language(code),
  href: new URL(localeHref(code), Astro.site).toString(),
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.categories
    .flatMap((category: { items: { question: string; answer: string }[] }) => category.items)
    .map((item: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripRichTextLinks(item.answer),
      },
    })),
};

// Ranked comparison of third-party credential managers, published on this
// page at #credential-managers. weightedScore (0-100, defined in
// src/data/credentialManagers.json) is rescaled to schema.org's bounded
// Rating scale; the letter grade is kept in reviewBody for transparency.
const credentialManagersUrl = new URL('/#credential-managers', Astro.site).toString();
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.credentialManagers.headline,
  url: credentialManagersUrl,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: [...managerScores]
    .sort((a, b) => b.weightedScore - a.weightedScore)
    .map((m, i) => {
      const data = (t.credentialManagers.managers as Record<string, { name: string; description: string }>)[m.key];
      return {
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: data.name,
          applicationCategory: 'SecurityApplication',
          review: {
            '@type': 'Review',
            author: { '@type': 'Organization', name: t.site.title },
            reviewRating: {
              '@type': 'Rating',
              ratingValue: (m.weightedScore / 20).toFixed(1),
              bestRating: '5',
              worstRating: '1',
            },
            reviewBody: `Grade ${m.grade} (${m.weightedScore}/100). ${data.description}`,
          },
        },
      };
    }),
};

// CF_PAGES_BRANCH is set by Cloudflare Pages at build time; PROD alone is true
// for preview deploys too, which would otherwise send preview traffic to the
// production Plausible tenant.
const isProductionDeploy = import.meta.env.PROD && import.meta.env.CF_PAGES_BRANCH === 'main';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t.site.title,
  description: t.site.description,
  url: Astro.site?.toString(),
};

const sections = [
  { id: 'hero', label: t.nav.sections.hero },
  { id: 'what-is', label: t.nav.sections.whatIs },
  { id: 'how-it-works', label: t.nav.sections.howItWorks },
  { id: 'why-passwords-fail', label: t.nav.sections.whyPasswordsFail },
  { id: 'phishing', label: t.nav.sections.phishing },
  { id: 'comparison', label: t.nav.sections.comparison },
  { id: 'credential-managers', label: t.nav.sections.credentialManagers },
  { id: 'say-goodbye', label: t.nav.sections.sayGoodbye },
  { id: 'work-passkeys', label: t.nav.sections.workPasskeys },
  { id: 'faq', label: t.nav.sections.faq },
];
---
<!doctype html>
<html lang={bcp47Language(locale)} data-mode="consumer">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('passkeys-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);

          var mode = localStorage.getItem('passkeys-mode');
          if (mode === 'technical') {
            document.documentElement.setAttribute('data-mode', 'technical');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{t.site.title}</title>
    <meta name="description" content={t.site.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    {hreflangLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={t.site.title} />
    <meta property="og:title" content={t.site.title} />
    <meta property="og:description" content={t.site.description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.site.description} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.site.title} />
    <meta name="twitter:description" content={t.site.description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#4f46e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

    <!-- Analytics (proxied through /metrics to avoid tracker blockers) -->
    {isProductionDeploy && (
      <script defer data-domain={Astro.site?.hostname} data-api="/metrics/event" src="/metrics/script"></script>
    )}
  </head>
  <body data-link-copied-text={t.nav.linkCopied} data-copy-link-template={t.nav.copyLinkToSection}>
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-indigo-600 focus:text-white focus:rounded-lg">
      {t.nav.skipToContent}
    </a>

    <Header locale={locale} t={t} />
    <SectionDots sections={sections} t={t} />

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} t={t} />

    <script>
      // Section dot navigation
      const dots = document.querySelectorAll('#section-dots a');
      const sectionIds = Array.from(dots).map(d => d.getAttribute('href')!.slice(1));

      function updateActiveDot() {
        const scrollY = window.scrollY;
        let activeId = sectionIds[0];
        for (const id of sectionIds) {
          const el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top <= window.innerHeight * 0.5) {
            activeId = id;
          }
        }
        dots.forEach(d => {
          d.classList.toggle('active', d.getAttribute('href') === '#' + activeId);
        });
      }

      let scrollTicking = false;
      window.addEventListener('scroll', () => {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(() => {
          updateActiveDot();
          scrollTicking = false;
        });
      }, { passive: true });
      updateActiveDot();

      // Copy-link-to-section on heading click
      const linkCopiedText = document.body.dataset.linkCopiedText!;
      const copyLinkTemplate = document.body.dataset.copyLinkTemplate!;

      const toast = document.createElement('div');
      toast.className = 'copy-toast';
      toast.textContent = linkCopiedText;
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');
      document.body.appendChild(toast);

      let toastTimeout: ReturnType<typeof setTimeout>;
      function showToast() {
        toast.classList.add('visible');
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => toast.classList.remove('visible'), 1600);
      }

      async function copySectionLink(id: string) {
        const url = `${location.origin}${location.pathname}#${id}`;
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        history.replaceState(null, '', `#${id}`);
        showToast();
      }

      sectionIds.forEach(id => {
        const section = document.getElementById(id);
        const heading = section?.querySelector('h2');
        if (!heading) return;

        heading.classList.add('section-link-heading');
        heading.setAttribute('tabindex', '0');
        heading.setAttribute('role', 'button');
        heading.setAttribute('aria-label', copyLinkTemplate.replace('{section}', heading.textContent?.trim() ?? ''));

        heading.addEventListener('click', () => copySectionLink(id));
        // Match native <button> behavior: Enter triggers on keydown, Space
        // triggers on keyup (keydown only prevents the page from scrolling).
        heading.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            copySectionLink(id);
          } else if (e.key === ' ') {
            e.preventDefault();
          }
        });
        heading.addEventListener('keyup', (e) => {
          if (e.key === ' ') {
            e.preventDefault();
            copySectionLink(id);
          }
        });
      });

      // Scroll reveal. Where the browser supports native CSS scroll-driven
      // animations (see the matching @supports block in global.css), the
      // .fade-in-section reveal is handled entirely by CSS and this
      // IntersectionObserver fallback is skipped.
      const supportsScrollDrivenAnimations = CSS.supports(
        '(animation-timeline: view()) and (animation-range: 0% 100%)'
      );

      if (!supportsScrollDrivenAnimations) {
        const fadeEls = document.querySelectorAll('.fade-in-section');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                observer.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        fadeEls.forEach(el => observer.observe(el));
      }

      // Flow step reveal
      const flowSteps = document.querySelectorAll('.flow-step');
      const flowObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              setTimeout(() => {
                e.target.classList.add('visible');
              }, parseInt((e.target as HTMLElement).dataset.delay ?? '0'));
              flowObserver.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      flowSteps.forEach(el => flowObserver.observe(el));
    </script>
  </body>
</html>
