#!/usr/bin/env bash
# Validates staged JSON files are syntactically correct before allowing a commit.
set -euo pipefail

status=0

while IFS= read -r file; do
  [ -z "$file" ] && continue
  if ! error=$(git show ":${file}" | node -e "JSON.parse(require('fs').readFileSync(0, 'utf8'))" 2>&1); then
    echo "✖ Invalid JSON: ${file}"
    echo "${error}" | sed 's/^/    /'
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.json')

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Commit aborted: fix the JSON errors above."
fi

exit "$status"
